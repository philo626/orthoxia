        <style>
            #sgs-sim-modal {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.85);
                backdrop-filter: blur(8px);
                z-index: 999999;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                direction: rtl;
                font-family: inherit;
            }

            .sgs-sim-content {
                background: linear-gradient(145deg, #1a2a44, #0d1626);
                border: 2px solid #f3ac3c;
                border-radius: 20px;
                padding: 30px;
                max-width: 450px;
                width: 100%;
                text-align: center;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
                position: relative;
            }

            .sgs-sim-title {
                color: #f3ac3c;
                font-size: 1.5rem;
                font-weight: 900;
                margin-bottom: 25px;
            }

            .sgs-sim-preview {
                background: rgba(255, 255, 255, 0.05);
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 25px;
                border: 1px dashed rgba(243, 172, 60, 0.3);
            }

            .sgs-preview-label {
                color: #ffffff;
                opacity: 0.6;
                font-size: 0.8rem;
                margin-bottom: 5px;
                display: block;
            }

            .sgs-preview-val {
                color: #ffffff;
                font-size: 1.2rem;
                font-weight: bold;
                display: block;
            }

            .sgs-preview-coptic {
                color: #f3ac3c;
                font-size: 1.3rem;
                margin-top: 10px;
                display: block;
                font-weight: 900;
            }

            .sgs-sim-input {
                width: 80%;
                max-width: 280px;
                display: block;
                margin-left: auto !important;
                margin-right: auto !important;
                padding: 12px;
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 10px;
                color: #fff;
                font-size: 1.1rem;
                text-align: center;
                direction: ltr;
                /* Force LTR for the date engine itself */
            }

            .sgs-sim-btns {
                display: flex;
                gap: 15px;
                justify-content: center;
            }

            .sgs-btn {
                padding: 12px 25px;
                border-radius: 10px;
                border: none;
                cursor: pointer;
                font-weight: bold;
                transition: all 0.3s ease;
            }

            .sgs-btn-go {
                background: #f3ac3c;
                color: #000;
            }

            .sgs-btn-today {
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
            }

            .sgs-btn-close {
                position: absolute;
                top: 15px;
                left: 15px;
                background: none;
                border: none;
                color: #fff;
                font-size: 1.5rem;
                cursor: pointer;
                opacity: 0.5;
            }

            .sgs-btn:hover {
                transform: translateY(-2px);
                opacity: 0.9;
            }
        </style>

        <div id="sgs-sim-modal">
            <div class="sgs-sim-content">
                <button class="sgs-btn-close" onclick="closeSgsPicker()">×</button>
                <div class="sgs-sim-title">تغيير التاريخ</div>

                <div style="display: flex; justify-content: center; width: 100%; margin-bottom: 25px;">
                    <input type="date" id="sgs-date-engine" class="sgs-sim-input" onchange="updateSgsPreview(this.value)"
                        style="margin: 0 !important;">
                </div>

                <div class="sgs-sim-preview">
                    <span class="sgs-preview-label">التاريخ الميلادي:</span>
                    <span id="sgs-prev-greg" class="sgs-preview-val">-- / -- / ----</span>
                    <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 15px 0;">
                    <span class="sgs-preview-label">التاريخ القبطي:</span>
                    <span id="sgs-prev-coptic" class="sgs-preview-coptic">-- ----- ---- ش</span>
                </div>

                <div class="sgs-sim-btns">
                    <button class="sgs-btn sgs-btn-today" onclick="simToday()">اليوم</button>
                    <button class="sgs-btn sgs-btn-go" onclick="simApply()">محاكاة</button>
                </div>
            </div>
        </div>

        <script>
            function openCopticDatePicker() {
                const modal = document.getElementById('sgs-sim-modal');
                modal.style.display = 'flex';

                // Set initial value to current URL param or today
                const urlParams = new URLSearchParams(window.location.search);
                const simDate = urlParams.get('sim_date');
                const engine = document.getElementById('sgs-date-engine');

                const today = new Date().toISOString().split('T')[0];
                engine.value = simDate || today;
                updateSgsPreview(engine.value);
            }

            function closeSgsPicker() {
                document.getElementById('sgs-sim-modal').style.display = 'none';
            }

            function updateSgsPreview(val) {
                if (!val) return;
                const d = new Date(val);

                // Gregorian Preview
                const gregFmt = new Intl.DateTimeFormat('ar-EG', { day: 'numeric', month: 'long', year: 'numeric' });
                document.getElementById('sgs-prev-greg').innerText = gregFmt.format(d);

                // Coptic Preview
                // Using ar-EG-u-ca-coptic for native Coptic calendar support
                try {
                    const copticFmt = new Intl.DateTimeFormat('ar-EG-u-ca-coptic', { day: 'numeric', month: 'long', year: 'numeric' });
                    let copticStr = copticFmt.format(d);
                    // Remove "AM" or "ص" if present (native formats sometimes include them)
                    copticStr = copticStr.replace(/\s*AM\s*/g, ' ').replace(/\s*ص\s*/g, ' ').trim();
                    document.getElementById('sgs-prev-coptic').innerText = '\u200F' + copticStr + ' ش';
                } catch (e) {
                    document.getElementById('sgs-prev-coptic').innerText = "جاري الحساب...";
                }
            }

            function simApply() {
                const val = document.getElementById('sgs-date-engine').value;
                if (val) {
                    window.location.href = window.location.pathname + '?sim_date=' + val;
                }
            }

            function simToday() {
                window.location.href = window.location.pathname;
            }

            // Close on escape
            window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSgsPicker(); });
        </script>
                <script type="text/javascript">
            (function () {
                const status = {"gregorian":"2026-11-15","coptic_day":6,"coptic_month":"\u0647\u0627\u062a\u0648\u0631","coptic_year":1743,"coptic_formatted":"\u200f6 \u0647\u0627\u062a\u0648\u0631 1743 \u0634","occasion_name":"\u0635\u0648\u0645 \u0627\u0644\u0631\u0633\u0644","occasion_subtitle":"\u00ab\u0627\u0644\u0631\u0633\u0644 \u0635\u0627\u0645\u0648\u0627 \u0648\u0635\u0644\u0648\u0627 \u0642\u0628\u0644 \u0627\u0644\u0643\u0631\u0627\u0632\u0629 \u0644\u0643\u064a \u062a\u0628\u0627\u0631\u0643 \u0627\u0644\u0646\u0639\u0645\u0629 \u062e\u062f\u0645\u062a\u0647\u0645\u00bb - \u0627\u0644\u0642\u062f\u064a\u0633 \u0643\u064a\u0631\u0644\u0633 \u0627\u0644\u0623\u0648\u0631\u0634\u0644\u064a\u0645\u064a","occasion_type":"fast","occasion_link":"https:\/\/stgeorgesaman.com\/occasions\/apostles-fast-feast\/","image_url":"https:\/\/stgeorgesaman.com\/wp-content\/uploads\/2026\/06\/Apost.png"};
                const textToShow = "\u0635\u0648\u0645 \u0627\u0644\u0631\u0633\u0644";
                function updateCopticUI() {
                    const buttons = document.querySelectorAll('.action_button, .button.action_button, #header_action_button, .header-action-btn a');
                    buttons.forEach(function (btn) {
                        btn.style.display = 'inline-block'; btn.style.visibility = 'visible'; btn.style.opacity = '1';
                        if (textToShow) {
                            const span = btn.querySelector('span');
                            if (span) { span.textContent = textToShow; } else { btn.textContent = textToShow; }
                        }
                        if (status.occasion_link) { btn.setAttribute('href', status.occasion_link); }
                        btn.setAttribute('title', status.coptic_formatted);
                    });
                    const mobileInfo = document.querySelector('.coptic-mobile-info');
                    if (mobileInfo) {
                        mobileInfo.innerHTML = `<span>${textToShow}</span><br><small>${status.coptic_formatted}</small>`;
                        const parentLink = mobileInfo.closest('a');
                        if (parentLink && status.occasion_link) { parentLink.setAttribute('href', status.occasion_link); }
                    }
                }
                function replaceOccasionImages() {
                    if (status.occasion_type === 'normal' || !status.image_url) return;
                    const targetFile = 'defoc-s.png';
                    document.querySelectorAll('img').forEach(function (img) {
                        const src = img.getAttribute('src') || '';
                        if (src.includes(targetFile)) { img.src = status.image_url; img.removeAttribute('srcset'); }
                    });
                    document.querySelectorAll('[style*="defoc-s.png"]').forEach(function (el) {
                        el.style.backgroundImage = `url('${status.image_url}')`;
                    });
                }
                updateCopticUI(); replaceOccasionImages();
                setTimeout(updateCopticUI, 1000); setTimeout(replaceOccasionImages, 1000);
            })();
        </script>
            <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Helper to clean parent/ancestor styling to prevent clipping or white capsules
            const cleanContainer = (el) => {
                if (!el) return;
                const id = el.id || '';
                const className = typeof el.className === 'string' ? el.className : (el.getAttribute && el.getAttribute('class') ? el.getAttribute('class') : '');
                // Shield all sgs custom components from styling erasure
                if (id.includes('sgs-') || className.includes('sgs-') || className.includes('sgs_')) {
                    return;
                }
                el.style.setProperty('background', 'transparent', 'important');
                el.style.setProperty('background-color', 'transparent', 'important');
                el.style.setProperty('border', 'none', 'important');
                el.style.setProperty('box-shadow', 'none', 'important');
                el.style.setProperty('overflow', 'visible', 'important');
                el.style.setProperty('height', 'auto', 'important');
                el.style.setProperty('padding', '0', 'important');
                el.style.setProperty('margin', '0', 'important');
            };

            const cleanFormContainers = () => {
                // Target all search forms and clean their parents and grandparents
                document.querySelectorAll('.sgs-search-form').forEach(form => {
                    if (form.parentElement) {
                        cleanContainer(form.parentElement);
                        if (form.parentElement.parentElement) {
                            cleanContainer(form.parentElement.parentElement);
                        }
                    }
                    
                    // Clean ancestors matching search keywords
                    let parent = form.parentElement;
                    while (parent && parent !== document.body) {
                        const id = (typeof parent.id === 'string') ? parent.id.toLowerCase() : (parent.getAttribute && parent.getAttribute('id') ? parent.getAttribute('id').toLowerCase() : '');
                        const className = (typeof parent.className === 'string') ? parent.className.toLowerCase() : (parent.getAttribute && parent.getAttribute('class') ? parent.getAttribute('class').toLowerCase() : '');
                        
                        // Shield all sgs custom components from styling erasure
                        if (id.includes('sgs-') || className.includes('sgs-') || className.includes('sgs_')) {
                            parent = parent.parentElement;
                            continue;
                        }

                        if (id.includes('search') || className.includes('search') || className.includes('asp_')) {
                            if (!className.includes('sgs-search-results-container') && !className.includes('sgs-search-hero') && !className.includes('sgs-search-hero-box')) {
                                cleanContainer(parent);
                            }
                        }
                        parent = parent.parentElement;
                    }
                });
                
                // Also target theme specific container selectors directly
                const selectors = [
                    '.search_wrapper', 
                    '#Top_bar .search_wrapper', 
                    '.menu_search', 
                    '.widget_search', 
                    '#searchform_wrapper',
                    '#searchform',
                    '.mfn-search-wrapper',
                    '.mfn-search',
                    '.mfn-search-form',
                    '.mfn-search-box',
                    '.mfn-header-search',
                    '.search-wrapper',
                    '.search-form'
                ];
                selectors.forEach(sel => {
                    document.querySelectorAll(sel).forEach(cleanContainer);
                });
            };

            // Function to bind event handlers to a search form
            const bindFormEvents = (form) => {
                const input = form.querySelector('.sgs-search-input');
                const filterBtn = form.querySelector('.sgs-search-filter-btn');
                const filterDrawer = form.querySelector('.sgs-search-filter-drawer');
                const suggestionsBox = form.querySelector('.sgs-ajax-suggestions');
                const clearBtn = form.querySelector('.sgs-search-clear-btn');
                
                let searchTimeout;
                let activeIndex = -1;
                
                // Bind dynamic triggers to re-apply container cleanup in case theme scripts toggle styles
                if (input) {
                    input.addEventListener('focus', function() {
                        cleanFormContainers();
                    });
                }
                
                // Toggle Filter Drawer
                if (filterBtn && filterDrawer) {
                    filterBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        // Hide suggestions
                        if (suggestionsBox) suggestionsBox.style.display = 'none';
                        filterDrawer.style.display = filterDrawer.style.display === 'none' ? 'block' : 'none';
                        cleanFormContainers();
                    });
                }
                
                // Close drawers on click outside (supporting SVG and nested element clicks)
                document.addEventListener('click', function(e) {
                    if (filterDrawer && !filterDrawer.contains(e.target) && filterBtn && !filterBtn.contains(e.target)) {
                        filterDrawer.style.display = 'none';
                    }
                    if (suggestionsBox && !suggestionsBox.contains(e.target) && input && !input.contains(e.target)) {
                        suggestionsBox.style.display = 'none';
                    }
                });

                // Toggle custom clear button and bind clear click handler
                if (input && clearBtn) {
                    const toggleClearBtn = () => {
                        if (input.value.trim().length > 0) {
                            clearBtn.style.setProperty('display', 'flex', 'important');
                        } else {
                            clearBtn.style.setProperty('display', 'none', 'important');
                        }
                    };
                    input.addEventListener('input', toggleClearBtn);
                    toggleClearBtn(); // Initial state check
                    
                    clearBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        input.value = '';
                        toggleClearBtn();
                        if (suggestionsBox) suggestionsBox.style.display = 'none';
                        input.focus();
                    });
                }
                
                // Stop propagation inside drawers so clicks don't close them
                if (filterDrawer) {
                    filterDrawer.addEventListener('click', e => e.stopPropagation());
                }
                if (suggestionsBox) {
                    suggestionsBox.addEventListener('click', e => e.stopPropagation());
                }
                
                // Typing/Input Event
                if (input && suggestionsBox) {
                    input.addEventListener('input', function() {
                        clearTimeout(searchTimeout);
                        const val = input.value.trim();
                        
                        if (val.length < 2) {
                            suggestionsBox.style.display = 'none';
                            return;
                        }
                        
                        // Immediately show circular loader in suggestionsBox to give instant visual feedback
                        suggestionsBox.innerHTML = `
                            <div class="sgs-suggestion-loading" style="padding: 24px; text-align: center; color: #053762; font-family: inherit; direction: rtl; display: flex; align-items: center; justify-content: center; gap: 12px; font-weight: 800;">
                                <svg class="sgs-spinner" width="20" height="20" viewBox="0 0 50 50" style="stroke: #FBB03B; fill: none; display: inline-block; vertical-align: middle;"><circle cx="25" cy="25" r="20" stroke-width="5" stroke-linecap="round" style="stroke-dasharray: 1, 150; stroke-dashoffset: 0; animation: sgs-dash 1.5s ease-in-out infinite;"></circle></svg>
                                <span>جاري البحث عن "${val}"...</span>
                            </div>
                        `;
                        suggestionsBox.style.display = 'block';
                        
                        searchTimeout = setTimeout(() => {
                            // Gather checked post types
                            const postTypes = [];
                            form.querySelectorAll('input[name="post_types[]"]:checked').forEach(cb => {
                                postTypes.push(cb.value);
                            });
                            
                            // Call Ajax
                            const ajaxUrl = 'https://stgeorgesaman.com/wp-admin/admin-ajax.php';
                            const url = new URL(ajaxUrl);
                            url.searchParams.append('action', 'sgs_global_search');
                            url.searchParams.append('q', val);
                            
                            postTypes.forEach(pt => {
                                url.searchParams.append('post_types[]', pt);
                            });
                            
                            fetch(url)
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success && data.data && data.data.html) {
                                        suggestionsBox.innerHTML = data.data.html;
                                        suggestionsBox.style.display = 'block';
                                        activeIndex = -1; // Reset selection index
                                        
                                        // Hide filter drawer if open
                                        if (filterDrawer) filterDrawer.style.display = 'none';
                                        
                                        // Bind submit to footer button
                                        const viewAllBtn = suggestionsBox.querySelector('.sgs-view-all-btn');
                                        if (viewAllBtn) {
                                            viewAllBtn.addEventListener('click', function(e) {
                                                e.preventDefault();
                                                form.submit();
                                            });
                                        }
                                    } else {
                                        suggestionsBox.style.display = 'none';
                                    }
                                })
                                .catch(err => {
                                    console.error('Search error:', err);
                                });
                        }, 300); // 300ms debounce
                    });
                    
                    // Keyboard navigation
                    input.addEventListener('keydown', function(e) {
                        const items = suggestionsBox.querySelectorAll('.sgs-suggestion-item');
                        if (suggestionsBox.style.display === 'none' || items.length === 0) return;
                        
                        if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            if (activeIndex >= 0) items[activeIndex].classList.remove('active');
                            activeIndex = (activeIndex + 1) % items.length;
                            items[activeIndex].classList.add('active');
                            items[activeIndex].scrollIntoView({ block: 'nearest' });
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            if (activeIndex >= 0) items[activeIndex].classList.remove('active');
                            activeIndex = (activeIndex - 1 + items.length) % items.length;
                            items[activeIndex].classList.add('active');
                            items[activeIndex].scrollIntoView({ block: 'nearest' });
                        } else if (e.key === 'Enter') {
                            if (activeIndex >= 0) {
                                e.preventDefault();
                                items[activeIndex].click();
                            }
                        }
                    });
                }
            };

            // Helper to generate new custom search markup
            const createCustomSearchForm = () => {
                const wrapper = document.createElement('div');
                wrapper.className = 'sgs-search-bar-replaced';
                wrapper.innerHTML = `
                    <form role="search" method="get" class="sgs-search-form" action="https://stgeorgesaman.com/">
                        <div class="sgs-search-box-wrap">
                            <div class="sgs-search-left-actions">
                                <button type="submit" class="sgs-search-icon-btn" aria-label="بحث">
                                    <i class="fas fa-search"></i>
                                </button>
                                <button type="button" class="sgs-search-filter-btn" aria-label="تصفية البحث">
                                    <i class="fas fa-sliders-h"></i>
                                </button>
                                <button type="button" class="sgs-search-clear-btn" aria-label="مسح البحث" style="display: none;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <input type="search" class="sgs-search-input" placeholder="ابحث هنا..." value="" name="s" autocomplete="off" />
                        </div>
                        
                        <!-- Filter Drawer -->
                        <div class="sgs-search-filter-drawer" style="display: none;">
                            <div class="sgs-filter-container">
                                <div class="sgs-filter-title">تصفية نتائج البحث حسب القسم:</div>
                                <div class="sgs-filter-options">
                                    <label class="sgs-filter-checkbox">
                                        <input type="checkbox" name="post_types[]" value="hymn" checked />
                                        <span class="checkbox-custom"></span>
                                        الألحان والتسجيلات
                                    </label>
                                    <label class="sgs-filter-checkbox">
                                        <input type="checkbox" name="post_types[]" value="dictionary_word" checked />
                                        <span class="checkbox-custom"></span>
                                        قاموس اللغة القبطية
                                    </label>
                                    <label class="sgs-filter-checkbox">
                                        <input type="checkbox" name="post_types[]" value="coptic_lesson" checked />
                                        <span class="checkbox-custom"></span>
                                        الدروس التعليمية
                                    </label>
                                    <label class="sgs-filter-checkbox">
                                        <input type="checkbox" name="post_types[]" value="books" checked />
                                        <span class="checkbox-custom"></span>
                                        مكتبة الكتب
                                    </label>
                                    <label class="sgs-filter-checkbox">
                                        <input type="checkbox" name="post_types[]" value="page" checked />
                                        <span class="checkbox-custom"></span>
                                        صفحات ومقالات الموقع
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Autocomplete Suggestions -->
                        <div class="sgs-ajax-suggestions" style="display: none;"></div>
                    </form>
                `;
                
                // Populate query if present to preserve search term on results page
                const input = wrapper.querySelector('.sgs-search-input');
                if (input) {
                    input.value = "";
                }
                return wrapper;
            };

            // Bind events for statically rendered forms on the page
            document.querySelectorAll('.sgs-search-form').forEach(form => {
                bindFormEvents(form);
            });

            // Replace default theme search inputs to inject our custom UX
            const replaceDefaultSearchForms = () => {
                // Gather direct forms to replace
                let formsToReplace = Array.from(document.querySelectorAll('form#searchform, form.search-form, form.widget_search form, form.menu_search form, form.mfn-search-form, form.mfn-form-search, form.searchform, form[role="search"]'));
                
                // Check in containers
                const containers = document.querySelectorAll('.search_wrapper, .menu_search, .widget_search, .asp_w, #searchform_wrapper, .mfn-search-wrapper, .mfn-search-box, .mfn-search, .mfn-header-search');
                containers.forEach(container => {
                    const innerForms = container.querySelectorAll('form');
                    if (innerForms.length > 0) {
                        innerForms.forEach(f => {
                            if (!formsToReplace.includes(f)) {
                                formsToReplace.push(f);
                            }
                        });
                    } else {
                        // Container with no form: hide original children instead of clearing, then append
                        if (!container.querySelector('.sgs-search-bar-replaced')) {
                            const wrapper = createCustomSearchForm();
                            Array.from(container.children).forEach(child => {
                                if (child !== wrapper && 
                                    !child.classList.contains('sgs-search-bar-replaced') &&
                                    !child.classList.contains('search_button') &&
                                    !child.classList.contains('mfn-search-toggle') &&
                                    !child.classList.contains('icon-search') &&
                                    child.id !== 'search_button') {
                                    child.style.setProperty('display', 'none', 'important');
                                }
                            });
                            container.appendChild(wrapper);
                            bindFormEvents(wrapper.querySelector('.sgs-search-form'));
                        }
                    }
                });

                // Execute replacement for all gathered forms
                formsToReplace.forEach(form => {
                    if (form.querySelector('.sgs-search-form') || form.classList.contains('sgs-search-form')) return;
                    if (form.parentNode && form.parentNode.querySelector('.sgs-search-bar-replaced')) return;
                    
                    const wrapper = createCustomSearchForm();
                    form.style.display = 'none';
                    form.classList.add('sgs-hidden-default-search');
                    if (form.parentNode) {
                        form.parentNode.insertBefore(wrapper, form.nextSibling);
                        // Hide siblings to prevent theme icons/input fragments showing around custom form
                        Array.from(form.parentNode.children).forEach(child => {
                            if (child !== wrapper && 
                                !child.classList.contains('sgs-search-bar-replaced') &&
                                !child.classList.contains('search_button') &&
                                !child.classList.contains('mfn-search-toggle') &&
                                !child.classList.contains('icon-search') &&
                                child.id !== 'search_button') {
                                child.style.setProperty('display', 'none', 'important');
                            }
                        });
                    }
                    bindFormEvents(wrapper.querySelector('.sgs-search-form'));
                });
                
                // Clean the containers
                cleanFormContainers();
            };

            // Listen to clicks on search toggle buttons to re-apply clean container styles
            document.querySelectorAll('.search_button, #search_button, .icon-search, a[href="#search"], .mfn-search-toggle').forEach(btn => {
                btn.addEventListener('click', function() {
                    setTimeout(cleanFormContainers, 50);
                    setTimeout(cleanFormContainers, 200);
                    setTimeout(cleanFormContainers, 500);
                });
            });

            // Trigger replacement at multiple stages of loading
            replaceDefaultSearchForms();
            setTimeout(replaceDefaultSearchForms, 100);
            setTimeout(replaceDefaultSearchForms, 300);
            setTimeout(replaceDefaultSearchForms, 600);
            setTimeout(replaceDefaultSearchForms, 1200);
            setTimeout(replaceDefaultSearchForms, 2500);
            window.addEventListener('load', replaceDefaultSearchForms);
        });
    </script>
