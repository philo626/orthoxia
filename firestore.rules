rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Require a signed-in Firebase Auth user
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isRegisteredPriest(uid) {
      return exists(/databases/$(database)/documents/priests/$(uid));
    }

    function isApprovedPriest(uid) {
      return exists(/databases/$(database)/documents/priests/$(uid))
        && get(/databases/$(database)/documents/priests/$(uid)).data.verificationStatus == 'approved';
    }

    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 0. Authorized Church / Diocese Verifiers (granted only via Firebase Console)
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 1. Public User Profiles (ONLY non-sensitive fields + private role & confessionFatherUid; ZERO confession notes!)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'displayName', 'patronSaintId', 'completedChapters',
             'role', 'confessionFatherUid', 'updatedAt'
           ])
        && validString(request.resource.data.displayName, 1, 60)
        && validString(request.resource.data.patronSaintId, 1, 60)
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['member', 'priest'])
        && (!('confessionFatherUid' in request.resource.data)
            || request.resource.data.confessionFatherUid == null
            || validString(request.resource.data.confessionFatherUid, 0, 128))
        && (!('completedChapters' in request.resource.data)
            || (request.resource.data.completedChapters is list
                && request.resource.data.completedChapters.size() <= 1500));
      allow delete: if isOwner(uid);
    }

    // 2. Community Prayer Wall
    match /prayer_requests/{docId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'title', 'content', 'isAnonymous', 'authorName', 'authorUid', 'prayedCount', 'createdAt'
           ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.isAnonymous is bool
        && validString(request.resource.data.title, 3, 120)
        && validString(request.resource.data.content, 5, 800)
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.prayedCount == 1;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedCount'])
        && request.resource.data.prayedCount is int
        && resource.data.prayedCount is int
        && (
             request.resource.data.prayedCount == resource.data.prayedCount + 1
             || (resource.data.prayedCount > 0 && request.resource.data.prayedCount == resource.data.prayedCount - 1)
           );

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // 3. Verified Coptic Priests Directory & Dual-Code Trust Verification
    match /priests/{priestUid} {
      // Public directory ONLY lists approved priests; private/pending readable only by owner or admin
      allow read: if resource.data.verificationStatus == 'approved'
        || isOwner(priestUid)
        || isAdmin();

      // Priest creates profile (starts pending for Public Directory; private code works immediately!)
      allow create: if isOwner(priestUid)
        && request.resource.data.priestUid == priestUid
        && request.resource.data.verificationStatus == 'pending'
        && validString(request.resource.data.displayName, 2, 80)
        && validString(request.resource.data.diocese, 2, 80)
        && validString(request.resource.data.church, 2, 120);

      allow update: if (
        // Priest updating own profile or resubmitting after 'needs_info' (cannot self-approve without valid invite)
        isOwner(priestUid)
        && request.resource.data.priestUid == priestUid
        && validString(request.resource.data.displayName, 2, 80)
        && validString(request.resource.data.diocese, 2, 80)
        && validString(request.resource.data.church, 2, 120)
        && (
             request.resource.data.verificationStatus == resource.data.verificationStatus
             || (resource.data.verificationStatus == 'needs_info'
                 && request.resource.data.verificationStatus == 'pending')
           )
      ) || (
        // Peer-Priest Vouching: atomic transaction redeeming an UNUSED invite code issued by an approved priest
        isOwner(priestUid)
        && request.resource.data.verificationStatus == 'approved'
        && ('vouchInviteCode' in request.resource.data)
        && validString(request.resource.data.vouchInviteCode, 5, 20)
        && exists(/databases/$(database)/documents/priest_invites/$(request.resource.data.vouchInviteCode))
        && get(/databases/$(database)/documents/priest_invites/$(request.resource.data.vouchInviteCode)).data.used == false
        && get(/databases/$(database)/documents/priest_invites/$(request.resource.data.vouchInviteCode)).data.issuerUid != priestUid
      ) || (
        // Authorized Church/Diocese Verifier approving or requesting completion
        isAdmin()
        && request.resource.data.verificationStatus in ['pending', 'approved', 'needs_info']
      );

      allow delete: if isOwner(priestUid) || isAdmin();
    }

    // 3b. Private Fixed Priest Lookup Codes (`AB-XXXX`) — direct lookup by exact code only (not listable!)
    match /priest_codes/{code} {
      allow get: if true;
      allow list: if false; // Prevents scraping private/unverified priests!
      allow create, update: if isSignedIn()
        && request.resource.data.priestUid == request.auth.uid
        && request.resource.data.code == code;
      allow delete: if isSignedIn() && resource.data.priestUid == request.auth.uid;
    }

    // 3c. Peer-Priest Vouch Invites (`KN-XXXX`) — supports 1 priest OR multi-priest church group (up to 15)
    match /priest_invites/{code} {
      // Exact code lookup allowed for signed-in priests; issuer can list their own issued invites
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.issuerUid == request.auth.uid;

      // ONLY already-approved priests or admins can issue new vouch codes
      allow create: if isSignedIn()
        && (isApprovedPriest(request.auth.uid) || isAdmin())
        && request.resource.data.issuerUid == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.code == code
        && (!('maxUses' in request.resource.data)
            || (request.resource.data.maxUses is int
                && request.resource.data.maxUses >= 1
                && request.resource.data.maxUses <= 15))
        && (!('usedCount' in request.resource.data)
            || request.resource.data.usedCount == 0);

      // Single-use OR Multi-use atomic increment: redeemable ONCE per distinct signed-in priest
      allow update: if isSignedIn()
        && resource.data.used == false
        && resource.data.issuerUid != request.auth.uid
        && (
          // Legacy single-use document (no maxUses field)
          (
            !('maxUses' in resource.data)
            && request.resource.data.used == true
            && request.resource.data.usedByUid == request.auth.uid
          )
          ||
          // Multi-use / group invite document (1..15 brother priests)
          (
            ('maxUses' in resource.data)
            && resource.data.maxUses is int
            && resource.data.usedCount is int
            && resource.data.usedCount < resource.data.maxUses
            && (!('usedByUids' in resource.data) || !(request.auth.uid in resource.data.usedByUids))
            && request.resource.data.usedCount == resource.data.usedCount + 1
            && request.resource.data.maxUses == resource.data.maxUses
            && request.resource.data.used == (request.resource.data.usedCount >= resource.data.maxUses)
          )
        );

      allow delete: if isSignedIn() && (resource.data.issuerUid == request.auth.uid || isAdmin());
    }

    // 4. Published Confession Sessions (Start time + optional End time + optional cap + instant close toggle)
    match /confession_sessions/{sessionId} {
      allow read: if true;

      // Any registered priest can publish sessions for his Private Code children &/or Public Directory
      allow create: if isSignedIn()
        && request.resource.data.priestUid == request.auth.uid
        && isRegisteredPriest(request.auth.uid)
        && validString(request.resource.data.dayLabelAr, 2, 60)
        && validString(request.resource.data.startTimeAr, 2, 40)
        && (!('endTimeAr' in request.resource.data)
            || request.resource.data.endTimeAr == ''
            || validString(request.resource.data.endTimeAr, 2, 40))
        && request.resource.data.isOpen is bool
        && request.resource.data.confirmedCount == 0
        && request.resource.data.waitlistCount == 0;

      allow update: if (
        isSignedIn()
        && resource.data.priestUid == request.auth.uid
      ) || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount', 'waitlistCount', 'updatedAt'])
        && request.resource.data.confirmedCount is int
        && request.resource.data.waitlistCount is int
        && request.resource.data.confirmedCount >= 0
        && request.resource.data.waitlistCount >= 0
        && request.resource.data.confirmedCount <= resource.data.confirmedCount + 1
        && request.resource.data.confirmedCount >= resource.data.confirmedCount - 1
        && request.resource.data.waitlistCount <= resource.data.waitlistCount + 1
        && request.resource.data.waitlistCount >= resource.data.waitlistCount - 1
      );

      allow delete: if isSignedIn() && resource.data.priestUid == request.auth.uid;

      // 4b. Session Attendees (STRICT PRIVACY: readable ONLY by the Priest or the attendee himself)
      match /attendees/{attendeeUid} {
        allow read: if isOwner(attendeeUid)
          || (isSignedIn() && get(/databases/$(database)/documents/confession_sessions/$(sessionId)).data.priestUid == request.auth.uid);

        allow create, update: if isOwner(attendeeUid)
          && request.resource.data.attendeeUid == request.auth.uid
          && request.resource.data.sessionId == sessionId
          && request.resource.data.status in ['confirmed', 'waitlist', 'cancelled']
          && validString(request.resource.data.attendeeName, 1, 60);

        allow delete: if isOwner(attendeeUid);
      }
    }

    // 5. Privacy-First Priest In-App Notification Inbox
    match /priest_notifications/{priestUid}/items/{itemId} {
      allow read, update, delete: if isOwner(priestUid);

      allow create: if isSignedIn()
        && request.resource.data.attendeeUid == request.auth.uid
        && request.resource.data.type in ['registered', 'waitlist', 'cancelled']
        && request.resource.data.read == false
        && validString(request.resource.data.attendeeName, 1, 60);
    }

    // 6. Altar Prayer Requests sent from Congregation to their Priest (STRICT PRIVACY: readable ONLY by the Priest!)
    match /priest_altar_requests/{priestUid}/items/{itemId} {
      allow read, update, delete: if isOwner(priestUid);

      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && validString(request.resource.data.personName, 2, 80)
        && request.resource.data.category in ['sick', 'departed', 'travelers', 'distressed', 'thanksgiving']
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 200)
        && request.resource.data.status == 'pending';
    }

    // 7. Free Live Multiplayer Friends Trivia Rooms (`trivia_rooms/{roomCode}`)
    match /trivia_rooms/{roomCode} {
      // Anyone signed in can look up a room by exact 6-char code (not publicly scrapeable)
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomCode == roomCode
        && request.resource.data.status == 'waiting'
        && request.resource.data.questionIndices is list
        && request.resource.data.questionIndices.size() >= 3
        && request.resource.data.questionIndices.size() <= 20;

      // Host controls room state (waiting -> playing -> finished)
      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.status in ['waiting', 'playing', 'finished'];

      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      // Players inside a room: readable by anyone in the room, writable ONLY by that player
      match /players/{playerUid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(playerUid)
          && request.resource.data.uid == playerUid
          && validString(request.resource.data.name, 1, 50)
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 10000
          && request.resource.data.answeredCount is int
          && request.resource.data.answeredCount >= 0
          && request.resource.data.answeredCount <= 25;
        allow delete: if isOwner(playerUid);
      }
    }

    // 8. Free Daily Online Orthodox Trivia Leaderboard (`daily_trivia/{dateIso}/scores/{uid}`)
    match /daily_trivia/{dateIso}/scores/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validString(request.resource.data.name, 1, 50)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 2500;
      allow delete: if isOwner(uid);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
