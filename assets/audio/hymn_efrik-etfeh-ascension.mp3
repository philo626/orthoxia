        }
        /* Sleek suggestions grid on mobile */
        .sgs-suggestions-list {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }
        .sgs-suggestion-item {
            padding: 12px !important;
        }
        .sgs-404-grid {
            gap: 20px !important;
        }
        .sgs-404-card {
            padding: 20px !important;
            border-radius: 20px !important;
        }
        .sgs-search-form.active {
            flex-direction: column !important;
            gap: 10px !important;
        }
        .sgs-search-btn {
            width: 100% !important;
            padding: 14px 20px !important;
        }
        .sgs-search-input {
            padding: 14px 45px 14px 15px !important;
            font-size: 0.95rem !important;
        }
    }

    .sgs-search-input-wrap {
        position: relative;
        flex: 1 !important;
        width: 100% !important;
        display: block !important;
    }

    .sgs-search-input-wrap i {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    .sgs-search-input {
        width: 100% !important;
        padding: 16px 50px 16px 20px !important;
        border: 2px solid #cbd5e1 !important;
        border-radius: 16px !important;
        font-size: 1.05rem !important;
        outline: none !important;
        transition: all 0.3s ease !important;
        background: #ffffff !important;
        color: #1e293b !important;
    }

    .sgs-search-input:focus {
        border-color: var(--brand-blue) !important;
        background: #ffffff !important;
        color: #1e293b !important;
        box-shadow: 0 0 0 4px rgba(5, 55, 98, 0.05) !important;
    }

    .sgs-search-btn {
        background: var(--brand-blue);
        color: #ffffff;
        border: none;
        padding: 16px 30px;
        border-radius: 16px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(5, 55, 98, 0.15);
        white-space: nowrap;
    }

    .sgs-search-btn:hover {
        background: var(--brand-gold);
        color: #0f172a;
        box-shadow: 0 4px 12px rgba(251, 176, 59, 0.3);
    }

    /* Make all icons inside buttons, tabs, links, and grid actions match parent text color perfectly */
    .sgs-404-container button i,
    .sgs-404-container button span,
    .sgs-404-container a i,
    .sgs-404-container a span,
    .sgs-404-container .sgs-search-tab i,
    .sgs-404-container .sgs-roulette-btn i,
    .sgs-404-container .sgs-search-btn i,
    .sgs-404-container .sgs-suggestion-item i {
        color: inherit !important;
        transition: color 0.3s ease;
    }

    /* Grid layout for Suggestions and Game */
    .sgs-404-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }

    @media (max-width: 900px) {
        .sgs-404-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Cards */
    .sgs-404-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.02);
        display: flex;
        flex-direction: column;
    }

    .sgs-card-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--brand-blue);
        margin: 0 0 20px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 2px solid var(--brand-gold);
        padding-bottom: 12px;
    }

    .sgs-card-title i {
        color: var(--brand-gold);
    }

    /* suggestions lists */
    .sgs-suggestions-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        flex: 1;
    }

    @media (max-width: 480px) {
        .sgs-suggestions-list {
            grid-template-columns: 1fr;
        }
    }

    .sgs-suggestion-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        text-decoration: none !important;
        color: var(--text-dark) !important;
        font-weight: 700;
        transition: all 0.3s ease;
    }

    .sgs-suggestion-item:hover {
        background: #ffffff;
        border-color: var(--brand-gold);
        box-shadow: 0 8px 20px rgba(251, 176, 59, 0.12);
        transform: translateY(-2px);
    }

    .sgs-suggestion-icon {
        width: 40px;
        height: 40px;
        background: rgba(5, 55, 98, 0.05);
        color: var(--brand-blue);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .sgs-suggestion-item:hover .sgs-suggestion-icon {
        background: var(--brand-gold);
        color: #0f172a;
    }

    /* Hymn Roulette Card */
    .sgs-roulette-container {
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
        padding: 10px 0;
    }

    .sgs-roulette-wheel {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: var(--brand-blue);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 20px;
        box-shadow: 0 8px 25px rgba(5, 55, 98, 0.2);
        cursor: pointer;
        position: relative;
        transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .sgs-roulette-wheel i {
        color: var(--brand-gold);
    }

    .sgs-roulette-wheel.spinning {
        animation: sgs-spin 0.6s infinite linear;
    }

    @keyframes sgs-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .sgs-roulette-result {
        min-height: 95px;
        margin-bottom: 20px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sgs-roulette-placeholder {
        color: var(--text-muted);
        font-size: 0.95rem;
        font-style: italic;
    }

    .sgs-roulette-hymn-card {
        background: #fffdf5;
        border: 1px solid rgba(251, 176, 59, 0.3);
        padding: 15px 20px;
        border-radius: 16px;
        animation: sgs-pop-in 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.1);
        text-align: center;
        width: 100%;
        box-shadow: 0 4px 10px rgba(251, 176, 59, 0.05);
    }

    @keyframes sgs-pop-in {
        0% { transform: scale(0.9); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    .sgs-roulette-hymn-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--brand-blue);
        margin-bottom: 8px;
    }

    .sgs-roulette-hymn-cantor {
        font-size: 0.9rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-bottom: 12px;
    }

    .sgs-roulette-btn {
        background: var(--brand-gold);
        color: #0f172a !important;
        border: none;
        padding: 12px 24px;
        border-radius: 30px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(251, 176, 59, 0.25);
        transition: all 0.3s ease;
        text-decoration: none !important;
    }

    .sgs-roulette-btn:hover {
        background: var(--brand-blue);
        color: #ffffff !important;
        box-shadow: 0 4px 15px rgba(5, 55, 98, 0.2);
        transform: translateY(-2px);
    }

    .sgs-roulette-listen-btn {
        background: var(--brand-blue);
        color: #ffffff !important;
        box-shadow: 0 4px 15px rgba(5, 55, 98, 0.15);
        padding: 8px 18px;
        font-size: 0.85rem;
        border-radius: 20px;
    }

    .sgs-roulette-listen-btn:hover {
        background: var(--brand-gold);
        color: #0f172a !important;
        box-shadow: 0 4px 15px rgba(251, 176, 59, 0.25);
    }
</style>

