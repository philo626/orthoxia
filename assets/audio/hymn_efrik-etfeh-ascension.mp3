<!-- SGS Popup System: Website Feedback -->
<div id="sgs-popup-overlay" style="display:none !important;" aria-hidden="true">
    <div id="sgs-popup-modal" role="dialog" aria-modal="true" aria-labelledby="sgs-popup-title" dir="rtl">

        <button id="sgs-popup-close" aria-label="إغلاق النافذة">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>

        <div class="sgs-popup-header">
            <h2 id="sgs-popup-title" class="sgs-popup-heading">
                رأيك يهمنا <span class="sgs-popup-heart-icon">&#10084;</span>
            </h2>
            <p class="sgs-popup-subheading">هنا نستقبل اقتراحاتك لتطوير الموقع</p>
        </div>

        <form id="sgs-popup-form" novalidate>
            <input type="hidden" name="form_type" value="website">

            <div class="sgs-popup-group">
                <label class="sgs-popup-label" for="sgs-popup-name">الاسم الكريم</label>
                <input type="text" id="sgs-popup-name" name="name" class="sgs-popup-field" placeholder="اسمك..." autocomplete="off">
            </div>

            <div class="sgs-popup-group">
                <label class="sgs-popup-label">كيف تقيم الموقع؟ <span class="sgs-popup-required">*</span></label>
                <div class="sgs-popup-hearts" id="sgs-popup-hearts" role="radiogroup" aria-label="تقييم الموقع من 1 إلى 5">
                    <i class="fas fa-heart" data-value="1" role="radio" aria-checked="false" aria-label="1 من 5" tabindex="0"></i>
                    <i class="fas fa-heart" data-value="2" role="radio" aria-checked="false" aria-label="2 من 5" tabindex="0"></i>
                    <i class="fas fa-heart" data-value="3" role="radio" aria-checked="false" aria-label="3 من 5" tabindex="0"></i>
                    <i class="fas fa-heart" data-value="4" role="radio" aria-checked="false" aria-label="4 من 5" tabindex="0"></i>
                    <i class="fas fa-heart" data-value="5" role="radio" aria-checked="false" aria-label="5 من 5" tabindex="0"></i>
                </div>
                <input type="hidden" name="rating" id="sgs-popup-rating" required>
                <div class="sgs-popup-rating-label" id="sgs-popup-rating-label" aria-live="polite"></div>
            </div>

            <div class="sgs-popup-group">
                <label class="sgs-popup-label">أي قسم لديك اقتراح بشأنه؟ <span class="sgs-popup-required">*</span></label>
                <div class="sgs-popup-chips" role="group" aria-label="اختر القسم">
                    <label class="sgs-popup-chip">
                        <input type="radio" name="section" value="مكتبة الألحان" required>
                        <span>مكتبة الألحان</span>
                    </label>
                    <label class="sgs-popup-chip">
                        <input type="radio" name="section" value="مكتبة الكتب">
                        <span>مكتبة الكتب</span>
                    </label>
                    <label class="sgs-popup-chip">
                        <input type="radio" name="section" value="أدوات اللغة القبطية">
                        <span>أدوات اللغة القبطية</span>
                    </label>
                    <label class="sgs-popup-chip">
                        <input type="radio" name="section" value="أخرى">
                        <span>أخرى</span>
                    </label>
                </div>
            </div>

            <div class="sgs-popup-group">
                <label class="sgs-popup-label" for="sgs-popup-suggestion">الاقتراح <span class="sgs-popup-required">*</span></label>
                <textarea id="sgs-popup-suggestion" name="suggestion" required rows="3" class="sgs-popup-field" placeholder="اكتب اقتراحاتك هنا..."></textarea>
            </div>

            <div class="sgs-popup-validation" id="sgs-popup-validation" role="alert" aria-live="assertive"></div>

            <button type="submit" id="sgs-popup-submit" class="sgs-popup-submit">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                إرسال
            </button>
        </form>

        <div id="sgs-popup-success" class="sgs-popup-success" style="display:none;" aria-live="polite">
            <div class="sgs-popup-success-icon"><i class="fas fa-check-circle" aria-hidden="true"></i></div>
            <p class="sgs-popup-success-title">شكراً جزيلاً!</p>
            <p class="sgs-popup-success-body">تم إرسال اقتراحك بنجاح. رأيك يُسهم في تطوير الموقع.</p>
        </div>

    </div>
</div>

<style>
#sgs-popup-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483600;
    display: none !important;
    align-items: center;
    justify-content: center;
    padding: 20px 14px;
    background: rgba(3, 18, 38, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    box-sizing: border-box;
    overflow-y: auto; /* overlay scrolls smoothly if modal is taller than viewport */
}
#sgs-popup-overlay.sgs-popup-visible {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
}
#sgs-popup-modal {
    position: relative;
    width: 100%;
    max-width: 490px;
    max-height: min(92vh, 720px);
    margin: auto;                            /* safe flex centering: prevents top/bottom clipping */
    overflow-y: auto;                        /* scrolls internally if needed */
    background: linear-gradient(150deg, #053762 0%, #064a86 55%, #053060 100%);
    border: 2px solid rgba(243, 172, 60, 0.30);
    border-radius: 24px;
    padding: 28px 24px 22px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.50), 0 0 0 1px rgba(243,172,60,0.08) inset, 0 1px 0 rgba(255,255,255,0.06) inset;
    font-family: inherit !important;
    direction: rtl;
    transform: scale(0.97) translateY(10px);
    transition: transform 0.30s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
#sgs-popup-overlay.sgs-popup-visible #sgs-popup-modal {
    transform: scale(1) translateY(0);
}
#sgs-popup-modal::before {
    content: 'ϯ';
    position: absolute;
    bottom: -12px;
    left: 4px;
    font-size: 8rem;
    opacity: 0.04;
    color: #f3ac3c;
    pointer-events: none;
    line-height: 1;
    user-select: none;
}
#sgs-popup-close {
    position: absolute;
    top: 14px;
    left: 16px;
    width: 34px;
    height: 34px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 50%;
    color: rgba(255,255,255,0.6);
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    padding: 0;
}
#sgs-popup-close:hover { background: rgba(243,172,60,0.18); color: #f3ac3c; transform: rotate(90deg) scale(1.1); }
#sgs-popup-close i { color: inherit !important; }
.sgs-popup-header { text-align: center; margin-bottom: 18px; }
.sgs-popup-heading { color: #fff; font-size: 1.55rem; font-weight: 900; margin: 0 0 6px 0; font-family: inherit !important; line-height: 1.3; }
.sgs-popup-heart-icon { color: #e05a5a; display: inline-block; animation: sgs-heartbeat 1.6s ease-in-out infinite; }
@keyframes sgs-heartbeat { 0%,100%{transform:scale(1)} 15%{transform:scale(1.3)} 30%{transform:scale(1)} 45%{transform:scale(1.18)} 60%{transform:scale(1)} }
.sgs-popup-subheading { color: rgba(255,255,255,0.55); font-size: 0.88rem; margin: 0; font-family: inherit !important; }
.sgs-popup-group { margin-bottom: 14px; }
.sgs-popup-label { display: block; color: #f3ac3c; font-size: 0.82rem; font-weight: 700; margin-bottom: 8px; letter-spacing: 0.3px; font-family: inherit !important; }
.sgs-popup-required { color: #e05a5a; margin-right: 2px; }
.sgs-popup-field,
input[type="text"].sgs-popup-field,
textarea.sgs-popup-field {
    width: 100% !important;
    background: rgba(255,255,255,0.08) !important;
    -webkit-appearance: none;
    appearance: none;
    border: 1.5px solid rgba(255,255,255,0.13) !important;
    border-radius: 12px !important;
    padding: 11px 14px !important;
    color: #ffffff !important;
    font-family: inherit !important;
    font-size: 0.93rem !important;
    outline: none !important;
    box-sizing: border-box;
    transition: border-color 0.25s, background 0.25s, color 0s;
    resize: none;
    text-align: right;
    caret-color: #f3ac3c;
    display: block;
}
/* Kill browser autofill override — keep the dark-blue background and white text */
.sgs-popup-field:-webkit-autofill,
.sgs-popup-field:-webkit-autofill:hover,
.sgs-popup-field:-webkit-autofill:focus,
.sgs-popup-field:-webkit-autofill:active { -webkit-box-shadow: 0 0 0 9999px #064a86 inset !important; -webkit-text-fill-color: #ffffff !important; caret-color: #f3ac3c; transition: background-color 9999s ease-in-out 0s; }
/* Keep white text on focus — prevents browser/theme overrides */
.sgs-popup-field:focus { border-color: rgba(243,172,60,0.55); background: rgba(255,255,255,0.10); color: #ffffff !important; }
/* Gold selection highlight instead of system blue */
.sgs-popup-field::selection { background: rgba(243,172,60,0.38); color: #ffffff; }
.sgs-popup-field::-moz-selection { background: rgba(243,172,60,0.38); color: #ffffff; }
.sgs-popup-field::placeholder { color: rgba(255,255,255,0.28); }
.sgs-popup-hearts { display: flex; gap: 14px; justify-content: center; font-size: 2rem; color: rgba(255,255,255,0.18); margin: 4px 0; direction: ltr; }
.sgs-popup-hearts i { cursor: pointer; transition: color 0.18s, transform 0.22s cubic-bezier(0.175,0.885,0.32,1.275); color: inherit !important; }
.sgs-popup-hearts i.sgs-h-hover, .sgs-popup-hearts i.sgs-h-active { color: #f3ac3c !important; filter: drop-shadow(0 0 8px rgba(243,172,60,0.45)); }
.sgs-popup-hearts i.sgs-h-hover { transform: scale(1.3); }
.sgs-popup-hearts i.sgs-h-active { transform: scale(1.15); }
.sgs-popup-rating-label { text-align: center; font-size: 0.78rem; color: rgba(255,255,255,0.45); min-height: 18px; margin-top: 4px; font-family: inherit !important; }
.sgs-popup-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.sgs-popup-chip { display: flex; align-items: center; gap: 9px; padding: 11px 13px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.09); border-radius: 11px; cursor: pointer; color: #fff; font-family: inherit !important; font-size: 0.88rem; transition: background 0.22s, border-color 0.22s, transform 0.18s; user-select: none; }
.sgs-popup-chip:hover { background: rgba(243,172,60,0.10); border-color: rgba(243,172,60,0.32); transform: translateY(-2px); }
.sgs-popup-chip input[type="radio"] { accent-color: #f3ac3c; width: 16px; height: 16px; flex-shrink: 0; }
.sgs-popup-chip:has(input:checked) { background: rgba(243,172,60,0.13); border-color: rgba(243,172,60,0.50); }
.sgs-popup-chip:has(input:checked) span { color: #f3ac3c; font-weight: 700; }
.sgs-popup-validation { min-height: 0; font-size: 0.82rem; color: #ff8a80; text-align: center; margin-bottom: 6px; font-family: inherit !important; }
.sgs-popup-submit { width: 100%; background: linear-gradient(135deg, #f3ac3c, #e09825); color: #053762; border: none; padding: 15px; border-radius: 13px; font-weight: 900; font-size: 1.05rem; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s; font-family: inherit !important; display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 4px; }
.sgs-popup-submit i { color: inherit !important; }
.sgs-popup-submit:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(243,172,60,0.40); }
.sgs-popup-submit:active:not(:disabled) { transform: scale(0.98); }
.sgs-popup-submit:disabled { opacity: 0.65; cursor: default; }
.sgs-popup-success { text-align: center; padding: 16px 0 8px; }
.sgs-popup-success-icon { font-size: 3.5rem; color: #66bb6a; margin-bottom: 14px; animation: sgs-popIn 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards; }
@keyframes sgs-popIn { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }
.sgs-popup-success-title { color: #fff; font-size: 1.3rem; font-weight: 900; margin: 0 0 8px; font-family: inherit !important; }
.sgs-popup-success-body { color: rgba(255,255,255,0.6); font-size: 0.9rem; margin: 0; font-family: inherit !important; line-height: 1.6; }
@media (max-width: 520px), (max-height: 750px) {
    #sgs-popup-modal {
        padding: 20px 16px 16px;
        border-radius: 20px;
        max-height: 94vh;
    }
    .sgs-popup-group { margin-bottom: 10px; }
    .sgs-popup-heading { font-size: 1.25rem; margin-bottom: 3px; }
    .sgs-popup-subheading { font-size: 0.8rem; }
    .sgs-popup-hearts { font-size: 1.55rem; gap: 8px; margin: 4px 0; }
    .sgs-popup-chips { grid-template-columns: 1fr 1fr; gap: 6px; }
    .sgs-popup-chip { padding: 7px 8px; font-size: 0.8rem; }
    .sgs-popup-field, input[type="text"].sgs-popup-field, textarea.sgs-popup-field {
        padding: 8px 12px !important;
        font-size: 0.88rem !important;
    }
    textarea.sgs-popup-field { min-height: 52px; }
    .sgs-popup-submit { padding: 11px; font-size: 0.95rem; margin-top: 2px; }
    #sgs-popup-overlay { padding: 10px; }
}
</style>

<script>
(function () {
    'use strict';
    var STORAGE_KEY       = 'sgs_popup_feedback_v1';
    var SESSION_KEY       = 'sgs_popup_fb_shown';
    var FORM_URL          = 'https://script.google.com/macros/s/AKfycbypTkuJMCbxg7wiq9J3maQGSIx8PqBatugM95ua9Az1Ai_s1SMpIxxO2XIKs9Sf4-LGcA/exec';
    var DELAY_FIRST_MS    = 25000;
    var DELAY_2ND_DAYS    = 4;
    var DELAY_REPEAT_DAYS = 21;
    var DELAY_SUBMIT_DAYS = 120;
    var ratingLabels      = ['','ضعيف','مقبول','جيد','جيد جداً','ممتاز ❤️'];

    function now()    { return Date.now(); }
    function dayMs(d) { return d * 86400000; }
    function loadState() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch(e) { return {}; } }
    function saveState(s) { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch(e) {} }

    function shouldShow() {
        if (sessionStorage.getItem(SESSION_KEY)) return false;
        var s          = loadState();
        var showCount  = s.showCount  || 0;
        var lastShown  = s.lastShown  || 0;
        var submitted  = s.submitted  || false;
        var lastSubmit = s.lastSubmit || 0;
        if (submitted)   return (now() - lastSubmit) >= dayMs(DELAY_SUBMIT_DAYS);
        if (showCount === 0) return true;
        if (showCount === 1) return (now() - lastShown) >= dayMs(DELAY_2ND_DAYS);
        return (now() - lastShown) >= dayMs(DELAY_REPEAT_DAYS);
    }

    function recordShown() {
        var s = loadState();
        s.showCount = (s.showCount || 0) + 1;
        s.lastShown = now();
        saveState(s);
        try { sessionStorage.setItem(SESSION_KEY, '1'); } catch(e) {}
    }

    function recordSubmitted() {
        var s = loadState();
        s.submitted  = true;
        s.lastSubmit = now();
        saveState(s);
    }

    var overlay    = document.getElementById('sgs-popup-overlay');
    var modal      = document.getElementById('sgs-popup-modal');
    var closeBtn   = document.getElementById('sgs-popup-close');
    var form       = document.getElementById('sgs-popup-form');
    var successDiv = document.getElementById('sgs-popup-success');
    var submitBtn  = document.getElementById('sgs-popup-submit');
    var validation = document.getElementById('sgs-popup-validation');
    var hearts     = document.querySelectorAll('#sgs-popup-hearts i');
    var ratingInput= document.getElementById('sgs-popup-rating');
    var ratingLbl  = document.getElementById('sgs-popup-rating-label');

    if (!overlay || !modal) return;

    function openPopup() {
        overlay.classList.add('sgs-popup-visible');
        overlay.style.setProperty('display', 'flex', 'important');
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                overlay.removeAttribute('aria-hidden');
            });
        });
        recordShown();
        setTimeout(function () { if (closeBtn) closeBtn.focus(); }, 400);
    }

    function closePopup() {
        overlay.classList.remove('sgs-popup-visible');
        overlay.setAttribute('aria-hidden', 'true');
        setTimeout(function () {
            overlay.style.setProperty('display', 'none', 'important');
            if (successDiv.style.display === 'none') resetForm();
        }, 380);
    }

    function resetForm() {
        form.reset();
        hearts.forEach(function(h) { h.classList.remove('sgs-h-active','sgs-h-hover'); });
        ratingInput.value = '';
        ratingLbl.textContent = '';
        validation.textContent = '';
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fas fa-paper-plane" aria-hidden="true"></i> إرسال';
    }

    function setHearts(val, type) {
        hearts.forEach(function (h) {
            var hVal = parseInt(h.getAttribute('data-value'), 10);
            if (type === 'hover') h.classList.toggle('sgs-h-hover', hVal <= val);
            else h.classList.toggle('sgs-h-active', hVal <= val);
        });
    }

    hearts.forEach(function (h) {
        h.addEventListener('click', function () {
            var val = parseInt(this.getAttribute('data-value'), 10);
            ratingInput.value = val;
            setHearts(val, 'active');
            ratingLbl.textContent = ratingLabels[val] || '';
        });
        h.addEventListener('mouseover', function () {
            setHearts(parseInt(this.getAttribute('data-value'), 10), 'hover');
        });
        h.addEventListener('mouseout', function () {
            hearts.forEach(function (hh) { hh.classList.remove('sgs-h-hover'); });
        });
        h.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.click(); }
        });
    });

    closeBtn.addEventListener('click', closePopup);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closePopup(); });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('sgs-popup-visible')) closePopup();
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        validation.textContent = '';
        if (!ratingInput.value) { validation.textContent = '⚠️ يرجى تقييم الموقع بالنقر على القلوب.'; return; }
        var sectionChecked = form.querySelector('input[name="section"]:checked');
        if (!sectionChecked) { validation.textContent = '⚠️ يرجى اختيار القسم الذي لديك اقتراح بشأنه.'; return; }
        var suggestion = (form.querySelector('[name="suggestion"]') || {}).value || '';
        if (suggestion.trim().length < 3) { validation.textContent = '⚠️ يرجى كتابة اقتراحك قبل الإرسال.'; return; }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> جاري الإرسال...';

        var formData = new FormData(form);
        formData.append('page_url', window.location.href);
        formData.append('page',     window.location.href);
        formData.append('url',      window.location.href);
        formData.append('source',   'popup');  /* extra identifier — harmless extra column in the sheet */

        fetch(FORM_URL, { method: 'POST', body: formData })
            .then(function () {
                recordSubmitted();
                form.style.display = 'none';
                successDiv.style.display = 'block';
                setTimeout(closePopup, 3500);
            })
            .catch(function (err) {
                console.error('[SGS Popup]', err);
                submitBtn.innerHTML = '<i class="fas fa-paper-plane" aria-hidden="true"></i> إرسال';
                submitBtn.disabled = false;
                validation.textContent = '⚠️ حدث خطأ، يرجى المحاولة مجدداً.';
            });
    });

    /* ── Admin: Reset state via URL param (?sgs_popup_reset=feedback|all) ── */
    var _urlP = (typeof URLSearchParams !== 'undefined') ? new URLSearchParams(window.location.search) : null;
    var _resetVal = _urlP ? _urlP.get('sgs_popup_reset') : null;
    if (_resetVal === 'feedback' || _resetVal === 'all') {
        try { localStorage.removeItem(STORAGE_KEY); sessionStorage.removeItem(SESSION_KEY); } catch(e) {}
    }

    /* ── Admin: Force-show via URL param (?sgs_popup_test=feedback) ── */
    var _testMode = _urlP ? _urlP.get('sgs_popup_test') === 'feedback' : false;

    /* Trigger */
    if (_testMode) {
        setTimeout(function () {
            openPopup();
            // Show orange test badge inside modal
            if (modal) {
                var _badge = document.createElement('div');
                _badge.style.cssText = 'position:absolute;top:10px;right:12px;background:rgba(220,80,0,0.88);color:#fff;font-size:0.68rem;font-weight:700;padding:3px 9px;border-radius:6px;letter-spacing:0.4px;z-index:10;pointer-events:none;';
                _badge.textContent = '\uD83E\uDDEA TEST MODE';
                modal.style.position = 'relative';
                modal.appendChild(_badge);
            }
        }, 600);
    } else {
        var s = loadState();
        var isFirstEver = (s.showCount || 0) === 0 && !s.submitted;
        if (shouldShow()) {
            var delay = isFirstEver ? DELAY_FIRST_MS : 800;
            setTimeout(function () { if (!document.hidden) openPopup(); }, delay);
        }
    }
})();
</script>


</body>
</html>
