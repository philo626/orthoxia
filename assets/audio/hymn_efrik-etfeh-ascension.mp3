<!-- Enqueue FontAwesome 6 stylesheet to guarantee that icons render correctly on stand-alone 404 views -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --brand-blue: #053762;
        --brand-gold: #FBB03B;
        --bg-light: #f8fafc;
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --card-bg: #ffffff;
        --card-border: #e2e8f0;
    }

    /* Override BeTheme layout wrappers on 404 pages to ensure full width and perfect centering */
    body.error404 #Content,
    body.error404 .content_wrapper,
    body.error404 .sections_wrapper,
    body.error404 .the_content_wrapper,
    body.error404 .section_wrapper,
    body.error404 .section,
    body.error404 .mcb-section-inner,
    body.error404 .mcb-wrap,
    body.error404 .mcb-wrap-inner {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 auto !important;
        box-shadow: none !important;
        background: transparent !important;
        border: none !important;
        float: none !important;
        display: block !important;
    }

    /* Force global font-family inheritance across all elements in the 404 view except for FontAwesome and icon glyph elements */
    .sgs-404-container,
    .sgs-404-container *:not(i):not([class*="fa-"]):not([class*="smmcico"]):not(.fa):not(.fas):not(.fab):not(.far):not(.glyphicon) {
        font-family: inherit !important;
    }

    /* Explicitly ensure FontAwesome and custom icons preserve their correct font-family and don't leak or inherit fallback family */
    .sgs-404-container i,
    .sgs-404-container [class*="fa-"],
    .sgs-404-container .fa,
    .sgs-404-container .fas,
    .sgs-404-container .fab,
    .sgs-404-container .far,
    .sgs-404-container .glyphicon,
    .sgs-404-container [class*="smmcico"] {
        font-family: "Font Awesome 5 Free", "Font Awesome 6 Free", "Font Awesome 5 Brands", "smmc", sans-serif !important;
    }

    .sgs-404-container,
    .sgs-404-container * {
        box-sizing: border-box !important;
    }

    .sgs-404-container {
        direction: rtl;
        background-color: var(--bg-light);
        color: var(--text-dark);
        margin: 0;
        padding: 0;
        line-height: 1.6;
        width: 100% !important;
        overflow-x: hidden !important;
    }

    .sgs-404-hero {
        background-color: var(--brand-blue);
        background-image: url("https://stgeorgesaman.com/wp-content/uploads/2021/03/pattern5.png");
        background-position: top center;
        background-repeat: repeat;
        padding: 80px 20px;
        text-align: center;
        border-bottom: 4px solid var(--brand-gold);
        position: relative;
    }

    .sgs-404-badge {
        display: inline-block;
        background: rgba(251, 176, 59, 0.2);
        color: var(--brand-gold);
        border: 1px solid var(--brand-gold);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .sgs-404-hero h1 {
        font-size: clamp(2.2rem, 5vw, 4rem);
        color: #ffffff;
        font-weight: 900;
        margin: 0 0 15px 0;
        text-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        line-height: 1.2;
    }

    .sgs-404-hero p {
        color: rgba(255, 255, 255, 0.9);
        font-size: clamp(1.05rem, 1.8vw, 1.25rem);
        max-width: 650px;
        margin: 0 auto;
    }

    .sgs-404-content-wrapper {
        width: 100% !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        float: none !important;
        clear: both !important;
        margin: 0 auto !important;
        padding: 0 !important;
        background: transparent !important;
    }

    .sgs-404-content {
        width: 100% !important;
        max-width: 1100px !important;
        margin: 40px auto 60px auto !important;
        padding: 0 20px !important;
        position: relative !important;
        z-index: 10 !important;
        display: block !important;
        float: none !important;
        clear: both !important;
    }

    /* Tabbed Search Section */
    .sgs-404-search-box {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(5, 55, 98, 0.08);
        padding: 30px;
        margin-bottom: 40px;
    }

    .sgs-search-tabs {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 15px;
        flex-wrap: wrap;
    }

    .sgs-search-tab {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 10px 20px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        border-radius: 12px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .sgs-search-tab.active {
        background: var(--brand-blue);
        color: #ffffff;
    }

    .sgs-search-tab:hover:not(.active) {
        background: #f1f5f9;
        color: var(--text-dark);
    }

    .sgs-search-form {
        display: none;
        align-items: center;
        gap: 12px;
        width: 100% !important;
    }

    .sgs-search-form.active {
        display: flex !important;
        flex-direction: row !important;
        float: none !important;
        clear: both !important;
    }

    @media (max-width: 600px) {
        .sgs-404-content {
            margin: 20px auto 40px auto !important;
            padding: 0 12px !important;
        }
        .sgs-404-search-box {
            padding: 20px 15px !important;
            border-radius: 20px !important;
            margin-bottom: 25px !important;
        }
        .sgs-404-hero {
            padding: 50px 15px !important;
        }
        /* Horizontally scrollable smooth search tabs on mobile */
        .sgs-search-tabs {
            display: flex !important;
            justify-content: flex-start !important;
            overflow-x: auto !important;
            white-space: nowrap !important;
            padding-bottom: 12px !important;
            border-bottom: 1px solid #e2e8f0 !important;
            gap: 8px !important;
            flex-wrap: nowrap !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none; /* Hide scrollbar for clean design */
        }
        .sgs-search-tabs::-webkit-scrollbar {
            display: none; /* Hide scrollbar for Safari/Chrome */
        }
        .sgs-search-tab {
            flex: 0 0 auto !important;
            padding: 8px 16px !important;
            font-size: 0.85rem !important;
