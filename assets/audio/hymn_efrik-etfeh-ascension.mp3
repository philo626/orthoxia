m\/libraries\/hymns-library\/raising-of-incense\/people-hymn\/and-with-your-spirit\/"},{"title":"\u062a\u0633\u0628\u062d\u0629 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629","cantor":"\u062e\u0648\u0631\u0633 \u062a\u0631\u0627\u062b \u0627\u0644\u0643\u0646\u064a\u0633\u0629 \u0627\u0644\u0642\u0628\u0637\u064a\u0629 \u0627\u0644\u0623\u0631\u062b\u0648\u0630\u0643\u0633\u064a\u0629 (HCOC)","url":"https:\/\/stgeorgesaman.com\/libraries\/hymns-library\/raising-of-incense\/people-hymn\/the-gloria\/"},{"title":"\u0645\u062f\u064a\u062d \u0644\u0635\u0648\u0645 \u0627\u0647\u0644 \u0646\u064a\u0646\u0648\u064a","cantor":"\u0627\u0644\u0645\u0631\u062a\u0644 \u0645\u0627\u062c\u062f \u063a\u0637\u0627\u0633","url":"https:\/\/stgeorgesaman.com\/libraries\/hymns-library\/occasionsandfeasts\/fast-of-nineveh\/nineveh-liturgy\/nineveh-hymn\/"},{"title":"\u0628\u0631\u0644\u0643\u0633 \u0645\u064a\u0644\u0627\u062f\u0627\u064b \u0639\u062c\u064a\u0628\u0627\u064b","cantor":"\u0627\u0644\u0645\u0631\u062a\u0644 \u0641\u0631\u062c \u0639\u0628\u062f \u0627\u0644\u0645\u0633\u064a\u062d","url":"https:\/\/stgeorgesaman.com\/libraries\/hymns-library\/occasionsandfeasts\/nativity\/liturgy-nativity\/pralix-genethlion\/"},{"title":"\u0630\u0643\u0635\u0648\u0644\u0648\u062c\u064a\u0629 \u0631\u0627\u0628\u0639\u0629 \u0644\u0644\u0634\u0647\u064a\u062f \u0627\u0628\u0627\u0633\u062e\u064a\u0631\u0648\u0646 \u0627\u0644\u0642\u0644\u064a\u0646\u064a","cantor":"\u062a\u0633\u062c\u064a\u0644\u0627\u062a \u0627\u0644\u0643\u0646\u064a\u0633\u0629","url":"https:\/\/stgeorgesaman.com\/libraries\/hymns-library\/raising-of-incense\/people-hymn\/doxologies\/doxology-steskharion-4\/"},{"title":"\u0645\u0632\u0645\u0648\u0631 150 \u0627\u0644\u0641\u0631\u0627\u064a\u062d\u064a \u062a\u0648\u0632\u064a\u0639 \u0639\u064a\u062f \u0627\u0644\u062e\u062a\u0627\u0646","cantor":"\u0627\u0644\u0645\u0631\u062a\u0644 \u0623\u0634\u0631\u0641 \u0639\u0637\u064a\u0629","url":"https:\/\/stgeorgesaman.com\/libraries\/hymns-library\/occasionsandfeasts\/circumcision\/liturgy-circumcision\/circumcision-psalm-150\/"},{"title":"\u0627\u0628\u0635\u0627\u0644\u064a\u0629 \u0622\u062f\u0627\u0645 \u062b\u0627\u0644\u062b\u0629 \u0639\u0644\u064a \u0627\u0644\u0647\u0648\u0633 \u0627\u0644\u062b\u0627\u0646\u064a","cantor":"\u062a\u0633\u062c\u064a\u0644\u0627\u062a \u0627\u0644\u0643\u0646\u064a\u0633\u0629","url":"https:\/\/stgeorgesaman.com\/libraries\/hymns-library\/occasionsandfeasts\/kiahk\/midnight-praise-kiahk-month\/adam-psali-on-second-hoos-3\/"}];
    const wheel = document.getElementById('sgs-wheel');
    const spinBtn = document.getElementById('sgs-spin-btn');
    const resultBox = document.getElementById('sgs-roulette-result');

    function spinRoulette() {
        if (wheel.classList.contains('spinning')) return;

        wheel.classList.add('spinning');
        resultBox.innerHTML = '<div style="color:var(--text-muted);font-style:italic;"><i class="fas fa-spinner fa-spin"></i> جاري سحب لحن روحي مبهج...</div>';

        // Spin animation timing
        setTimeout(() => {
            wheel.classList.remove('spinning');
            
            if (!hymnsList || hymnsList.length === 0) {
                resultBox.innerHTML = '<div class="sgs-roulette-placeholder">لم نتمكن من سحب لحن عشوائي حالياً، يرجى المحاولة لاحقاً.</div>';
                return;
            }

            const randIndex = Math.floor(Math.random() * hymnsList.length);
            const hymn = hymnsList[randIndex];

            resultBox.innerHTML = `
                <div class="sgs-roulette-hymn-card">
                    <div class="sgs-roulette-hymn-title">${hymn.title}</div>
                    <div class="sgs-roulette-hymn-cantor"><i class="fas fa-microphone"></i> أداء: ${hymn.cantor}</div>
                    <a href="${hymn.url}" class="sgs-roulette-btn sgs-roulette-listen-btn">
                        <i class="fas fa-play"></i> استمع للحن الآن
                    </a>
                </div>
            `;
        }, 1000);
    }

    wheel.addEventListener('click', spinRoulette);
    spinBtn.addEventListener('click', spinRoulette);
</script>



