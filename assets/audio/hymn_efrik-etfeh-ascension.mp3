        .sgs-search-tab-link i,
        .sgs-result-card-footer i {
            color: inherit !important;
        }

        .sgs-search-form {
            width: 100%;
            margin: 0 auto;
            position: relative;
            font-family: inherit;
            background: transparent !important;
            background-color: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }
        
        .sgs-search-box-wrap {
            display: flex;
            align-items: center;
            background: rgba(5, 55, 98, 0.93) !important; /* Premium semi-transparent blue */
            border-radius: 50px;
            padding: 2px 6px;
            position: relative;
            border: 2px solid rgba(251, 176, 59, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            direction: ltr; /* Icons left, text right (RTL inside) */
            box-shadow: 0 4px 15px rgba(5, 55, 98, 0.15);
        }
        
        .sgs-search-box-wrap:focus-within {
            border-color: #FBB03B;
            box-shadow: 0 8px 25px rgba(251, 176, 59, 0.3);
            transform: translateY(-1px);
        }
        
        .sgs-search-left-actions {
            display: flex;
            align-items: center;
            padding-left: 12px;
            gap: 8px;
        }
        
        .sgs-search-icon-btn, .sgs-search-filter-btn, .sgs-search-clear-btn {
            background: none !important;
            border: none !important;
            color: #ffffff !important;
            font-size: 1.2rem !important;
            cursor: pointer !important;
            padding: 10px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            transition: all 0.2s ease !important;
            opacity: 0.85 !important;
            margin: 0 !important;
            height: auto !important;
            width: auto !important;
            line-height: 1 !important;
        }
        
        .sgs-search-icon-btn:hover, .sgs-search-filter-btn:hover, .sgs-search-clear-btn:hover {
            color: #FBB03B !important;
            opacity: 1 !important;
            transform: scale(1.1);
        }

        /* Suppress WebKit native cancel button */
        .sgs-search-input::-webkit-search-cancel-button,
        .sgs-search-input::-webkit-search-decoration,
        input[type="search"]::-webkit-search-cancel-button,
        input[type="search"]::-webkit-search-decoration {
            -webkit-appearance: none !important;
            appearance: none !important;
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        /* Suppress MS Edge native clear button */
        .sgs-search-input::-ms-clear,
        input[type="search"]::-ms-clear {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }

        /* Ensure theme dark mode compatibility for the capsule */
        body.mode-dark .sgs-search-box-wrap,
        body.mode-pascha .sgs-search-box-wrap {
            background: rgba(18, 18, 18, 0.95) !important;
            border-color: rgba(251, 176, 59, 0.4) !important;
        }
        body.mode-dark:has(#sgs-hp) .sgs-search-box-wrap,
        body.mode-pascha:has(#sgs-hp) .sgs-search-box-wrap {
            background: rgba(13, 17, 23, 0.95) !important;
        }
        
        .sgs-search-input {
            flex: 1 !important;
            background: none !important;
            border: none !important;
            color: #ffffff !important;
            font-size: 1.1rem !important;
            padding: 12px 20px !important;
            text-align: right !important;
            direction: rtl !important;
            outline: none !important;
            width: 100% !important;
            box-shadow: none !important;
            font-family: inherit !important;
            margin: 0 !important;
            height: 48px !important;
        }
        
        .sgs-search-input::placeholder {
            color: rgba(255, 255, 255, 0.6) !important;
            opacity: 1 !important;
        }
        
        /* Filter Drawer */
        .sgs-search-filter-drawer {
            position: absolute;
            top: 105%;
            left: 0;
            right: 0;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            padding: 16px 20px;
            z-index: 999999 !important;
            direction: rtl;
            animation: sgsSlideDown 0.25s ease-out;
        }
        
        .sgs-filter-title {
            font-weight: 800;
            color: #053762;
            margin-bottom: 12px;
            font-size: 0.95rem;
        }
        
        .sgs-filter-options {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .sgs-filter-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: #334155;
            cursor: pointer;
            user-select: none;
            position: relative;
        }
        
        .sgs-filter-checkbox input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            height: 0;
            width: 0;
        }
        
        .checkbox-custom {
            height: 18px;
            width: 18px;
            background-color: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            display: inline-block;
            position: relative;
            transition: all 0.2s ease;
        }
        
        .sgs-filter-checkbox:hover input ~ .checkbox-custom {
            border-color: #FBB03B;
        }
        
        .sgs-filter-checkbox input:checked ~ .checkbox-custom {
            background-color: #053762;
            border-color: #053762;
        }
        
        .checkbox-custom:after {
            content: "";
            position: absolute;
            display: none;
            left: 6px;
            top: 2px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }
        
        .sgs-filter-checkbox input:checked ~ .checkbox-custom:after {
            display: block;
        }
        
        /* Suggestions list */
        .sgs-ajax-suggestions {
            position: absolute;
            top: 105%;
            left: 0;
            right: 0;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(5, 55, 98, 0.15);
            z-index: 999999 !important;
            direction: rtl;
            overflow: hidden;
            animation: sgsSlideDown 0.25s ease-out;
        }
        
        .sgs-suggestion-group {
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 8px;
        }
        
        .sgs-suggestion-group:last-child {
            border-bottom: none;
        }
        
        .sgs-suggestion-group-title {
            font-size: 0.85rem;
            font-weight: 900;
            color: #FBB03B;
            background: rgba(5, 55, 98, 0.03);
            padding: 8px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .sgs-suggestion-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            text-decoration: none !important;
            transition: all 0.2s ease;
            gap: 12px;
        }
        
        .sgs-suggestion-item:hover, .sgs-suggestion-item.active {
            background-color: rgba(5, 55, 98, 0.05);
            transform: translateX(-4px);
        }
        
        .sgs-suggestion-info {
            display: flex;
            flex-direction: column;
            flex: 1;
            text-align: right;
        }
        
        .sgs-suggestion-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: #053762;
            line-height: 1.3;
        }
        
        .sgs-suggestion-title.ltr-title {
            direction: ltr;
            text-align: right;
        }
        
        .sgs-suggestion-meta {
            font-size: 0.8rem;
            color: #64748b;
            margin-top: 4px;
        }
        
        /* Dark Mode Overrides for Suggestions */
        body.mode-dark .sgs-ajax-suggestions,
        body.mode-pascha .sgs-ajax-suggestions {
            background: #1c2230 !important;
            border-color: #2d3748 !important;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45) !important;
        }
        
        body.mode-dark .sgs-suggestion-group-title,
        body.mode-pascha .sgs-suggestion-group-title {
            background: rgba(255, 255, 255, 0.03) !important;
        }
        
        body.mode-dark .sgs-suggestion-title,
        body.mode-pascha .sgs-suggestion-title {
            color: #ffffff !important;
        }
        
        body.mode-dark .sgs-suggestion-meta,
        body.mode-pascha .sgs-suggestion-meta {
            color: #a0aec0 !important;
        }
        
        body.mode-dark .sgs-suggestion-item:hover,
        body.mode-dark .sgs-suggestion-item.active,
        body.mode-pascha .sgs-suggestion-item:hover,
        body.mode-pascha .sgs-suggestion-item.active {
            background-color: rgba(255, 255, 255, 0.05) !important;
        }
        
        body.mode-dark .sgs-suggestions-footer,
        body.mode-pascha .sgs-suggestions-footer {
            background: #141923 !important;
            border-top-color: #2d3748 !important;
        }
        
        body.mode-dark .sgs-view-all-btn,
        body.mode-pascha .sgs-view-all-btn {
            color: #FBB03B !important;
        }
        
        .tool-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }
        
        .sgs-highlight {
            color: #FBB03B;
            background: rgba(251, 176, 59, 0.1);
            padding: 1px 4px;
            border-radius: 4px;
            font-weight: 900;
        }
        
        @keyframes sgsSlideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Scrollbar styles for suggestion wrapper */
        .sgs-suggestions-scroll-wrapper::-webkit-scrollbar {
            width: 8px;
        }
        
        .sgs-suggestions-scroll-wrapper::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        
        .sgs-suggestions-scroll-wrapper::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        
        .sgs-suggestions-scroll-wrapper::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
