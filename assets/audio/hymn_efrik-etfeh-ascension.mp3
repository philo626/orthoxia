    </div>
</div>

<script>
    // Tab switching logic
    document.querySelectorAll('.sgs-search-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.sgs-search-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.sgs-search-form').forEach(f => f.classList.remove('active'));

            tab.classList.add('active');
            const targetId = tab.getAttribute('data-target');
            document.getElementById(targetId).classList.add('active');
        });
    });

    // Hymn Roulette logic
