            style="box-sizing: border-box; max-width: 380px; margin: 0 auto; width: 100%; direction: rtl; text-align: right;">

            <!-- Quick Links Section -->
            <div style="margin-bottom: 25px;">
                <h5
                    style="color: #f3ac3c; font-size: 1.1rem; font-weight: 900; margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa fa-link" style="font-size: 0.9rem; opacity: 0.8;"></i> روابط سريعة
                </h5>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                            <a href="https://stgeorgesaman.com/coptic/readings/" class="footer-link-item"
                            style="text-decoration: none; color: #ffffff; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; font-weight: 600; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-bible" style="color: #f3ac3c; font-size: 0.8rem;"></i>
                            قطمارس اليوم                        </a>
                                            <a href="https://stgeorgesaman.com/coptic/readings/#synaxarium" class="footer-link-item"
                            style="text-decoration: none; color: #ffffff; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; font-weight: 600; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-book-open" style="color: #f3ac3c; font-size: 0.8rem;"></i>
                            السنكسار اليومي                        </a>
                                            <a href="http://stgeorgesaman.com/coptic/coptic-words-flashcards/" class="footer-link-item"
                            style="text-decoration: none; color: #ffffff; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; font-weight: 600; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-clone" style="color: #f3ac3c; font-size: 0.8rem;"></i>
                            كروت تعليمية                        </a>
                                            <a href="https://stgeorgesaman.com/coptic/coptic-bible/" class="footer-link-item"
                            style="text-decoration: none; color: #ffffff; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; font-weight: 600; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-scroll" style="color: #f3ac3c; font-size: 0.8rem;"></i>
                            الكتاب المقدس                        </a>
                                    </div>
            </div>

            <!-- Newsletter Section (Click-to-Reveal) -->
            <div style="margin-bottom: 25px;">
                <h5
                    style="color: #f3ac3c; font-size: 1.1rem; font-weight: 900; margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa fa-envelope-open-text" style="font-size: 0.9rem; opacity: 0.8;"></i> اشترك في القائمة البريدية
                </h5>
                <button onclick="toggleFooterNewsletter()"
                    style="width: 100%; background: rgba(243, 172, 60, 0.1); border: 1px solid rgba(243, 172, 60, 0.3); border-radius: 12px; padding: 12px; color: #f3ac3c; font-weight: bold; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; gap: 10px;"
                    onmouseover="this.style.background='rgba(243, 172, 60, 0.2)'"
                    onmouseout="this.style.background='rgba(243, 172, 60, 0.1)'">
                    <i class="fa fa-paper-plane"></i> انضم لمجتمعنا الرقمي
                </button>

                <!-- Hidden Overlay Form -->
                <div id="footerNewsletterOverlay" class="sgs-footer-overlay"
                    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
                    <div class="sgs-overlay-content"
                        style="background: #053762; border: 2px solid #f3ac3c; border-radius: 25px; width: 100%; max-width: 450px; padding: 40px 30px; position: relative; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
                        <button onclick="toggleFooterNewsletter()"
                            style="position: absolute; top: 15px; left: 15px; background: none; border: none; color: #f3ac3c; font-size: 1.5rem; cursor: pointer; opacity: 0.7;"
                            onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">&times;</button>

                        <div style="font-size: 3rem; margin-bottom: 20px;">📩</div>
                        <h3 style="color: #ffffff; margin-bottom: 10px; font-weight: 900;">اشترك لتصلك تحديثاتنا</h3>
                        <p style="color: rgba(255,255,255,0.7); margin-bottom: 30px; font-size: 0.95rem;">كن أول من يعرف عن
                            القراءات الجديدة والمناسبات الكنسية والمقالات التعليمية.</p>

                        <form id="sgsNewsletterForm"
                            action="https://assets.mailerlite.com/jsonp/2351405/forms/187547234493007580/subscribe"
                            method="post" style="display: flex; flex-direction: column; gap: 15px;">
                            <input type="email" name="fields[email]" required placeholder="بريدك الإلكتروني..."
                                style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(243, 172, 60, 0.4); border-radius: 15px; padding: 15px; color: #ffffff; font-family: inherit; font-size: 1rem; outline: none; text-align: center;">
                            <input type="hidden" name="ml-submit" value="1">
                            <input type="hidden" name="anticsrf" value="true">

                            <button type="submit"
                                style="background: #f3ac3c; color: #053762; border: none; padding: 15px; border-radius: 15px; font-weight: 900; font-size: 1.1rem; cursor: pointer; transition: all 0.3s ease;"
                                onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                                اشتراك الآن
                            </button>
                            <div id="sgsNewsletterFeedback"
                                style="display: none; color: #4CAF50; font-weight: bold; margin-top: 5px; font-size: 0.9rem;">تم
                                الاشتراك بنجاح! شكراً لك.</div>
                        </form>
                    </div>
                </div>
                <script>
                    function toggleFooterNewsletter() {
                        const overlay = document.getElementById('footerNewsletterOverlay');
                        if (overlay.style.display === 'flex') {
                            overlay.classList.add('sgs-closing');
                            setTimeout(() => {
                                overlay.style.display = 'none';
                                overlay.classList.remove('sgs-closing');
                            }, 400);
                        } else {
                            overlay.style.display = 'flex';
                        }
                    }

                    document.getElementById('sgsNewsletterForm').addEventListener('submit', function (e) {
                        e.preventDefault();
                        const form = this;
                        const submitBtn = form.querySelector('button[type="submit"]');
                        const feedback = document.getElementById('sgsNewsletterFeedback');

                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> جاري الاشتراك...';

                        const formData = new FormData(form);

                        fetch(form.action, {
                            method: 'POST',
                            body: formData
                        })
                            .then(response => {
                                submitBtn.style.display = 'none';
                                feedback.style.display = 'block';

                                setTimeout(() => {
                                    toggleFooterNewsletter();
                                    form.reset();
                                    submitBtn.disabled = false;
                                    submitBtn.style.display = 'block';
                                    submitBtn.innerHTML = 'اشتراك الآن';
                                    feedback.style.display = 'none';
                                }, 3000);
                            })
                            .catch(error => {
                                console.error('Error!', error.message);
                                submitBtn.innerHTML = 'حدث خطأ، حاول مرة أخرى';
                                submitBtn.disabled = false;
                            });
                    });
                </script>

                <!-- Contact Us Button -->
                <button onclick="toggleFooterContact()"
                    style="width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-weight: bold; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px;"
                    onmouseover="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='#f3ac3c';"
                    onmouseout="this.style.background='rgba(255, 255, 255, 0.05)'; this.style.borderColor='rgba(255, 255, 255, 0.1)';">
                    <i class="fa fa-comment-dots"></i> تواصل معنا مباشرة
                </button>

                <!-- Hidden Contact Overlay Form -->
                <div id="footerContactOverlay" class="sgs-footer-overlay"
                    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 99999; align-items: center; justify-content: center; padding: 20px 14px; box-sizing: border-box; overflow-y: auto;">
                    <div class="sgs-overlay-content"
                        style="background: #053762; border: 2px solid #f3ac3c; border-radius: 25px; width: 100%; max-width: 500px; max-height: 94vh; overflow-y: auto; margin: auto; padding: 30px 24px; position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.5); box-sizing: border-box;">
                        <button onclick="toggleFooterContact()"
                            style="position: absolute; top: 15px; left: 15px; background: none; border: none; color: #f3ac3c; font-size: 1.5rem; cursor: pointer; opacity: 0.7;"
                            onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">&times;</button>

                        <style>
                            .rating-stars i:hover,
                            .rating-stars i.active {
                                color: #f3ac3c !important;
                                text-shadow: 0 0 10px rgba(243, 172, 60, 0.5);
                            }

                            .rating-stars i {
                                transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s;
                            }

                            .rating-stars i:hover {
                                transform: scale(1.3);
                            }

                            .sgs-chip-label {
                                background: rgba(255, 255, 255, 0.05);
                                padding: 10px;
                                border-radius: 10px;
                                border: 1px solid rgba(255, 255, 255, 0.1);
                                display: flex;
                                align-items: center;
                                gap: 8px;
                                cursor: pointer;
                                transition: all 0.3s ease;
                            }

                            .sgs-chip-label:hover {
                                background: rgba(243, 172, 60, 0.1);
                                border-color: rgba(243, 172, 60, 0.3);
                                transform: translateY(-2px);
                            }

                            .sgs-chip-label input:checked+span {
                                color: #f3ac3c;
                                font-weight: bold;
                            }

                            /* Closing animations */
                            .sgs-footer-overlay.sgs-closing {
                                animation: sgsFadeOut 0.4s ease-in forwards !important;
                            }

                            .sgs-footer-overlay.sgs-closing .sgs-overlay-content {
                                animation: sgsZoomOut 0.4s ease-in forwards !important;
                            }

                            @keyframes sgsFadeOut {
                                from {
                                    opacity: 1;
                                }

                                to {
                                    opacity: 0;
                                }
                            }

                            @keyframes sgsZoomOut {
                                from {
                                    transform: scale(1);
                                    opacity: 1;
                                }

                                to {
                                    transform: scale(0.85);
                                    opacity: 0;
                                }
                            }
                        </style>

                        <!-- Step 1: Choice -->
                        <div id="sgsContactStepChoice" style="display: block; text-align: center;">
                            <h3 style="color: #ffffff; margin-bottom: 10px; font-weight: 900;">يسعدنا تواصلك معنا</h3>
                            <p style="color: rgba(255,255,255,0.6); margin-bottom: 25px; font-size: 0.9rem;">هل تواصلك يتعلق
                                بالموقع الإلكتروني واقتراحات تطويره؟</p>

                            <div style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                                <button onclick="sgsShowContactForm('website')"
                                    style="background: #f3ac3c; color: #053762; border: none; padding: 15px; border-radius: 12px; font-weight: 900; font-size: 1rem; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; gap: 10px;">
                                    <i class="fa fa-desktop" style="color: inherit !important;"></i> نعم، بخصوص تطوير الموقع
                                </button>
                                <button onclick="sgsShowContactForm('general')"
                                    style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #ffffff; padding: 15px; border-radius: 12px; font-weight: 900; font-size: 1rem; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; gap: 10px;"
                                    onmouseover="this.style.background='rgba(255,255,255,0.1)'"
                                    onmouseout="this.style.background='rgba(255,255,255,0.05)'">
                                    <i class="fa fa-envelope" style="color: inherit !important;"></i> لا، تواصل عام / استفسار
                                    آخر
                                </button>
                            </div>
                        </div>

                        <!-- Step 2: General Form (Existing) -->
                        <div id="sgsContactFormGeneral" style="display: none; text-align: right; direction: rtl;">
                            <h3 style="color: #ffffff; margin-bottom: 5px; font-weight: 900; text-align: center;">يسعدنا تواصلك
                                معنا</h3>
                            <p
                                style="color: rgba(255,255,255,0.6); margin-bottom: 20px; font-size: 0.9rem; text-align: center;">
                                اترك رسالتك وسنقوم بالرد عليك في أقرب وقت.</p>

                            <form id="sgsFormGeneral" style="display: flex; flex-direction: column; gap: 12px;">
                                <input type="hidden" name="form_type" value="general">
                                <div>
                                    <label
                                        style="color: #f3ac3c; font-size: 0.8rem; margin-bottom: 5px; display: block; font-weight: bold;">الاسم
                                        الكامل</label>
                                    <input type="text" name="name" required placeholder="اسمك الكريم..."
                                        style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-family: inherit; outline: none;">
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                    <div>
                                        <label
                                            style="color: #f3ac3c; font-size: 0.8rem; margin-bottom: 5px; display: block; font-weight: bold;">البريد
                                            الإلكتروني (اختياري)</label>
                                        <input type="email" name="email" placeholder="example@mail.com"
                                            style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-family: inherit; outline: none;">
                                    </div>
                                    <div>
                                        <label
                                            style="color: #f3ac3c; font-size: 0.8rem; margin-bottom: 5px; display: block; font-weight: bold;">رقم
                                            الموبايل</label>
                                        <input type="tel" name="mobile" required placeholder="01xxxxxxxxx"
                                            style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-family: inherit; outline: none;">
                                    </div>
                                </div>
                                <div>
                                    <label
                                        style="color: #f3ac3c; font-size: 0.8rem; margin-bottom: 5px; display: block; font-weight: bold;">رسالتك</label>
                                    <textarea name="message" required rows="4" placeholder="اكتب استفسارك أو رسالتك هنا..."
                                        style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-family: inherit; outline: none; resize: none;"></textarea>
                                </div>

                                <button type="submit" id="sgsContactSubmit"
                                    style="background: #f3ac3c; color: #053762; border: none; padding: 15px; border-radius: 15px; font-weight: 900; font-size: 1.1rem; cursor: pointer; transition: all 0.3s ease; margin-top: 10px;">
                                    إرسال الرسالة
                                </button>
                                <div id="sgsContactFeedback"
                                    style="display: none; color: #4CAF50; font-weight: bold; margin-top: 10px; font-size: 0.9rem; text-align: center;">
                                    تم الإرسال بنجاح! شكراً لتواصلك معنا.</div>
                            </form>
                        </div>

                        <!-- Step 2: Website Form (New Improved) -->
                        <div id="sgsContactFormWebsite" style="display: none; text-align: right; direction: rtl;">
                            <h3 style="color: #ffffff; margin-bottom: 5px; font-weight: 900; text-align: center;">رأيك يهمنا !
                                ❤️</h3>
                            <p
                                style="color: rgba(255,255,255,0.6); margin-bottom: 20px; font-size: 0.9rem; text-align: center;">
                                هنا نستقبل اقتراحاتك لتطوير الموقع</p>

                            <form id="sgsFormWebsite" style="display: flex; flex-direction: column; gap: 15px;">
                                <input type="hidden" name="form_type" value="website">
                                <div>
                                    <label
                                        style="color: #f3ac3c; font-size: 0.85rem; margin-bottom: 5px; display: block; font-weight: bold;">الاسم
                                        الكريم</label>
                                    <input type="text" name="name" required placeholder="اسمك..."
                                        style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-family: inherit; outline: none;">
                                </div>

                                <div>
                                    <label
                                        style="color: #f3ac3c; font-size: 0.85rem; margin-bottom: 5px; display: block; font-weight: bold;">كيف
                                        تقيم الموقع؟ *</label>
                                    <div class="rating-stars"
                                        style="display: flex; gap: 10px; justify-content: center; font-size: 1.8rem; color: rgba(255,255,255,0.2); cursor: pointer;">
                                        <i class="fas fa-heart" data-value="1"></i>
                                        <i class="fas fa-heart" data-value="2"></i>
                                        <i class="fas fa-heart" data-value="3"></i>
                                        <i class="fas fa-heart" data-value="4"></i>
                                        <i class="fas fa-heart" data-value="5"></i>
                                    </div>
                                    <input type="hidden" name="rating" id="sgsRatingValue" required>
                                </div>

                                <div>
                                    <label
                                        style="color: #f3ac3c; font-size: 0.85rem; margin-bottom: 5px; display: block; font-weight: bold;">أي
                                        قسم لديك اقتراح بشأنه؟ *</label>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                        <label class="sgs-chip-label">
                                            <input type="radio" name="section" value="مكتبة الألحان" required
                                                style="accent-color: #f3ac3c;">
                                            <span>مكتبة الألحان</span>
                                        </label>
                                        <label class="sgs-chip-label">
                                            <input type="radio" name="section" value="مكتبة الكتب"
                                                style="accent-color: #f3ac3c;">
                                            <span>مكتبة الكتب</span>
                                        </label>
                                        <label class="sgs-chip-label">
                                            <input type="radio" name="section" value="أدوات اللغة القبطية"
                                                style="accent-color: #f3ac3c;">
                                            <span>أدوات اللغة القبطية</span>
                                        </label>
                                        <label class="sgs-chip-label">
                                            <input type="radio" name="section" value="أخرى" style="accent-color: #f3ac3c;">
                                            <span>أخرى</span>
                                        </label>
                                    </div>
                                </div>

                                <div>
                                    <label
                                        style="color: #f3ac3c; font-size: 0.85rem; margin-bottom: 5px; display: block; font-weight: bold;">الاقـتراح
                                        *</label>
                                    <textarea name="suggestion" required rows="4" placeholder="اكتب اقتراحاتك هنا..."
                                        style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #ffffff; font-family: inherit; outline: none; resize: none;"></textarea>
                                </div>

                                <button type="submit" id="sgsWebsiteSubmit"
                                    style="background: #f3ac3c; color: #053762; border: none; padding: 15px; border-radius: 12px; font-weight: 900; font-size: 1.1rem; cursor: pointer; transition: all 0.3s ease; margin-top: 5px;">
                                    إرسال
                                </button>
                                <div id="sgsWebsiteFeedback"
                                    style="display: none; color: #4CAF50; font-weight: bold; margin-top: 10px; font-size: 0.9rem; text-align: center;">
                                    تم الإرسال بنجاح! شكراً لمساعدتنا في تطوير الموقع.</div>
                            </form>
                        </div>
                    </div>
                </div>

                <script>
                    function sgsShowContactForm(type) {
                        document.getElementById('sgsContactStepChoice').style.display = 'none';
                        if (type === 'general') {
                            document.getElementById('sgsContactFormGeneral').style.display = 'block';
                        } else {
                            document.getElementById('sgsContactFormWebsite').style.display = 'block';
                        }
                    }

                    function toggleFooterContact() {
                        const overlay = document.getElementById('footerContactOverlay');
                        if (overlay.style.display === 'flex') {
                            overlay.classList.add('sgs-closing');
                            setTimeout(() => {
                                overlay.style.display = 'none';
                                overlay.classList.remove('sgs-closing');
                            }, 400);
                        } else {
                            overlay.style.display = 'flex';
                            document.getElementById('sgsContactStepChoice').style.display = 'block';
                            document.getElementById('sgsContactFormGeneral').style.display = 'none';
                            document.getElementById('sgsContactFormWebsite').style.display = 'none';
                            document.getElementById('sgsFormGeneral').reset();
                            document.getElementById('sgsFormWebsite').reset();
                            document.querySelectorAll('.rating-stars i').forEach(s => {
                                s.classList.remove('active');
                                s.style.color = 'rgba(255,255,255,0.2)';
                                s.style.transform = 'scale(1)';
                            });
                            document.getElementById('sgsRatingValue').value = '';
                        }
                    }

                    // Star rating logic
                    document.querySelectorAll('.rating-stars i').forEach(star => {
                        star.addEventListener('click', function () {
                            const value = this.getAttribute('data-value');
                            document.getElementById('sgsRatingValue').value = value;
                            document.querySelectorAll('.rating-stars i').forEach(s => {
                                if (s.getAttribute('data-value') <= value) {
                                    s.classList.add('active');
                                    s.style.color = '#f3ac3c';
                                } else {
                                    s.classList.remove('active');
                                    s.style.color = 'rgba(255,255,255,0.2)';
                                }
                            });
                        });
                        star.addEventListener('mouseover', function () {
                            const value = this.getAttribute('data-value');
                            document.querySelectorAll('.rating-stars i').forEach(s => {
                                if (s.getAttribute('data-value') <= value) {
                                    s.style.color = '#f3ac3c';
                                }
                            });
                        });
                        star.addEventListener('mouseout', function () {
                            const currentValue = document.getElementById('sgsRatingValue').value;
                            document.querySelectorAll('.rating-stars i').forEach(s => {
                                if (currentValue && s.getAttribute('data-value') <= currentValue) {
                                    s.style.color = '#f3ac3c';
                                } else {
                                    s.style.color = 'rgba(255,255,255,0.2)';
                                }
                            });
                        });
                    });

                    function sgsHandleFormSubmit(formId, submitBtnId, feedbackId) {
                        const form = document.getElementById(formId);
                        if (!form) return;

                        form.addEventListener('submit', function (e) {
                            e.preventDefault();
                            const submitBtn = document.getElementById(submitBtnId);
                            const feedback = document.getElementById(feedbackId);

                            submitBtn.disabled = true;
                            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> جاري الإرسال...';

                            const scriptURL = 'https://script.google.com/macros/s/AKfycbypTkuJMCbxg7wiq9J3maQGSIx8PqBatugM95ua9Az1Ai_s1SMpIxxO2XIKs9Sf4-LGcA/exec';

                            const formData = new FormData(form);
                            formData.append('page_url', window.location.href);
                            formData.append('page', window.location.href);
                            formData.append('url', window.location.href);

                            fetch(scriptURL, { method: 'POST', body: formData })
                                .then(response => {
                                    submitBtn.style.display = 'none';
                                    feedback.style.display = 'block';
                                    setTimeout(() => {
                                        toggleFooterContact();
                                        form.reset();
                                        submitBtn.disabled = false;
                                        submitBtn.style.display = 'block';
                                        submitBtn.innerHTML = formId === 'sgsFormWebsite' ? 'إرسال' : 'إرسال الرسالة';
                                        feedback.style.display = 'none';
                                    }, 3000);
                                })
                                .catch(error => {
                                    console.error('Error!', error.message);
                                    submitBtn.innerHTML = 'حدث خطأ، حاول مرة أخرى';
                                    submitBtn.disabled = false;
                                });
                        });
                    }

                    sgsHandleFormSubmit('sgsFormGeneral', 'sgsContactSubmit', 'sgsContactFeedback');
                    sgsHandleFormSubmit('sgsFormWebsite', 'sgsWebsiteSubmit', 'sgsWebsiteFeedback');
                </script>
            </div>

            <!-- Social Links Section -->
            <div>
                <h5 style="color: #f3ac3c; font-size: 0.9rem; font-weight: 900; margin-bottom: 12px; opacity: 0.8;">تابعنا على:
                </h5>
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <a href="https://www.facebook.com/StGeorgeSaman" target="_blank" class="footer-social-icon"
                        title="Facebook - StGeorgeSaman"
                        style="color: #ffffff; font-size: 1.1rem; background: rgba(255,255,255,0.05); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="https://www.facebook.com/hymnslibrary" target="_blank" class="footer-social-icon"
                        title="Facebook - Hymns Library"
                        style="color: #ffffff; font-size: 1.1rem; background: rgba(255,255,255,0.05); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
                        <i class="fab fa-facebook"></i>
                    </a>
                    <a href="https://www.youtube.com/StGeorgeSaman" target="_blank" class="footer-social-icon" title="YouTube"
                        style="color: #ffffff; font-size: 1.1rem; background: rgba(255,255,255,0.05); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
                        <i class="fab fa-youtube"></i>
                    </a>
                    <a href="https://soundcloud.com/StGeorgeSaman" target="_blank" class="footer-social-icon" title="SoundCloud"
                        style="color: #ffffff; font-size: 1.1rem; background: rgba(255,255,255,0.05); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
                        <i class="fab fa-soundcloud"></i>
                    </a>
                    <a href="https://x.com/Stgeorgesaman" target="_blank" class="footer-social-icon" title="X (Twitter)"
                        style="color: #ffffff; font-size: 1.1rem; background: rgba(255,255,255,0.05); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
                        <i class="icon-x-twitter"></i>
                    </a>
                    <a href="https://www.instagram.com/stgeorgesaman/" target="_blank" class="footer-social-icon"
                        title="Instagram"
                        style="color: #ffffff; font-size: 1.1rem; background: rgba(255,255,255,0.05); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
                        <i class="fab fa-instagram"></i>
                    </a>
                </div>
            </div>
        </div>
        <style>
            .footer-link-item:hover {
                background: rgba(243, 172, 60, 0.1) !important;
                border-color: rgba(243, 172, 60, 0.3) !important;
                color: #f3ac3c !important;
                transform: translateX(-5px);
            }

            .footer-newsletter input:focus {
                background: rgba(255, 255, 255, 0.1) !important;
                border-color: #f3ac3c !important;
                box-shadow: 0 0 10px rgba(243, 172, 60, 0.2);
            }

            .footer-social-icon:hover {
                background: #f3ac3c !important;
                color: #053762 !important;
                transform: translateY(-3px);
                border-color: #f3ac3c !important;
            }

            body.mode-dark .footer-link-item,
            body.mode-pascha .footer-link-item {
                background: rgba(0, 0, 0, 0.2) !important;
            }

            @keyframes sgsFadeIn {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            @keyframes sgsZoomIn {
                from {
                    transform: scale(0.85);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            .sgs-footer-overlay {
                animation: sgsFadeIn 0.4s ease-out;
            }

            .sgs-overlay-content {
                animation: sgsZoomIn 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
            }
        </style>
        </p>
</aside></div></div></div></div>
		
			<div class="footer_copy">
				<div class="container">
					<div class="column one mobile-one">
            <div class="mcb-column-inner">

              
              <div class="copyright">
                كنيسة الشهيد العظيم مارجرجس بنزلة السمان © 2026              </div>

