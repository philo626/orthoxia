<!DOCTYPE html>
<html dir="rtl" lang="ar" prefix="og: https://ogp.me/ns#" class="no-js " itemscope itemtype="https://schema.org/WebPage" >

<head>

<meta charset="UTF-8" />
<style>
        /* Permanently hide BeTheme default subheader on single custom post types and library pages */
        body.single-hymn #Subheader,
        body.single-prayer #Subheader,
        body.single-prayers #Subheader,
        body.single-dictionary_word #Subheader,
        body.single-coptic_lesson #Subheader,
        body.single-coptic_bible #Subheader,
        body.single-books #Subheader,
        body.page-template-default:has(#hym-hero-title) #Subheader,
        body:has(.sw-wrapper) #Subheader,
        body:has(#sgs-hp) #Subheader,
        body:has(.bible-main-wrapper) #Subheader,
        body:has(.lessons-main-container) #Subheader,
        body:has(.hym-wrapper) #Subheader,
        body:has(.csk-main-container) #Subheader,
        body:has(#sgs-fathers-page) #Subheader,
        body:has(#sgs-liturgies-page) #Subheader,
        body:has(.sgs-liturgies-page-tmpl) #Subheader,
        body:has(#sgs-stgeorge-page) #Subheader,
        body:has(.sgs-stgeorge-page-tmpl) #Subheader,
        body:has(#sgs-contact-page) #Subheader,
        body:has(.sgs-contact-page-tmpl) #Subheader,
        #Subheader.hide-subheader,
        .sgs-hide-subheader #Subheader {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Permanently prevent popup flash (FOUC) before JS triggers */
        #sgs-popup-overlay:not(.sgs-popup-visible) {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
        }

        /* Top Bar Header & Icon Color Matching on All Pages */
        .sgs-app-top-bar .sgs-top-icon,
        .sgs-lesson-top-bar h1 i.sgs-top-icon,
        .sgs-hymn-top-bar h1 i.sgs-top-icon {
            color: #444444 !important;
            transition: color 0.2s ease !important;
        }
        .sgs-app-top-bar h1 a:hover,
        .sgs-app-top-bar h1 a:hover .sgs-top-icon,
        .sgs-app-top-bar h1.sgs-top-bar-title a:hover,
        .sgs-app-top-bar h1.sgs-top-bar-title a:hover .sgs-top-icon,
        .sgs-lesson-top-bar h1 a:hover,
        .sgs-lesson-top-bar h1 a:hover i.sgs-top-icon,
        .sgs-hymn-top-bar h1 a:hover,
        .sgs-hymn-top-bar h1 a:hover i.sgs-top-icon {
            color: #053762 !important;
        }

        /* Mobile Top Bar & Hero Section Standardization */
        @media (max-width: 767px) {
            .sgs-app-top-bar,
            .sgs-lesson-top-bar,
            .sgs-hymn-top-bar {
                padding: 16px 12px 14px 12px !important;
            }
            .sgs-app-top-bar h1,
            .sgs-app-top-bar h1.sgs-top-bar-title,
            .sgs-lesson-top-bar h1,
            .sgs-hymn-top-bar h1 {
                font-size: 24px !important;
                line-height: 1.3 !important;
                gap: 8px !important;
            }
            .sgs-app-top-bar h1 a,
            .sgs-app-top-bar h1.sgs-top-bar-title a,
            .sgs-lesson-top-bar h1 a,
            .sgs-hymn-top-bar h1 a {
                font-size: 24px !important;
                gap: 8px !important;
                flex-direction: row !important;
                flex-wrap: nowrap !important;
            }
            .sgs-app-top-bar .sgs-top-icon,
            .sgs-lesson-top-bar h1 i.sgs-top-icon,
            .sgs-hymn-top-bar h1 i.sgs-top-icon {
                font-size: 26px !important;
            }
            .sgs-breadcrumbs {
                font-size: 12px !important;
                margin: 8px 0 0 0 !important;
                line-height: 1.6 !important;
            }
            .sgs-breadcrumbs ul.breadcrumbs {
                gap: 3px !important;
                justify-content: center !important;
            }
            .sgs-breadcrumbs .mfn-breadcrumbs-separator {
                margin: 0 4px !important;
                font-size: 9px !important;
            }

            .sgs-lesson-hero-section,
            .sgs-hymn-hero-section {
                padding: 28px 14px 30px 14px !important;
            }
            .sgs-lesson-title,
            .sgs-hymn-arabic-title {
                font-size: clamp(1.6rem, 6.5vw, 2.2rem) !important;
                line-height: 1.35 !important;
                word-break: break-word !important;
            }
            .sgs-lesson-cop-title,
            .sgs-hymn-coptic-title {
                font-size: clamp(1.1rem, 4.5vw, 1.4rem) !important;
                margin-bottom: 10px !important;
            }
        }

        /* Dark / Pascha Mode Top Bar Icon Colors */
        body.mode-dark .sgs-app-top-bar .sgs-top-icon,
        body.mode-dark .sgs-lesson-top-bar h1 i.sgs-top-icon,
        body.mode-dark .sgs-hymn-top-bar h1 i.sgs-top-icon {
            color: #FBB03B !important;
        }
        body.mode-dark .sgs-app-top-bar h1 a:hover .sgs-top-icon,
        body.mode-dark .sgs-app-top-bar h1.sgs-top-bar-title a:hover .sgs-top-icon,
        body.mode-dark .sgs-lesson-top-bar h1 a:hover i.sgs-top-icon,
        body.mode-dark .sgs-hymn-top-bar h1 a:hover i.sgs-top-icon {
            color: #FFFFFF !important;
        }

        body.mode-pascha .sgs-app-top-bar .sgs-top-icon,
        body.mode-pascha .sgs-lesson-top-bar h1 i.sgs-top-icon,
        body.mode-pascha .sgs-hymn-top-bar h1 i.sgs-top-icon {
            color: #BE0000 !important;
        }
        body.mode-pascha .sgs-app-top-bar h1 a:hover .sgs-top-icon,
        body.mode-pascha .sgs-app-top-bar h1.sgs-top-bar-title a:hover .sgs-top-icon,
        body.mode-pascha .sgs-lesson-top-bar h1 a:hover i.sgs-top-icon,
        body.mode-pascha .sgs-hymn-top-bar h1 a:hover i.sgs-top-icon {
            color: #FFFFFF !important;
        }
